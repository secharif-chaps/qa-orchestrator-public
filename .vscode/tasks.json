{
  "version": "2.0.0",
  "tasks": [
    // ═══════════════════════════════════════════════
    //  DOCKER COMPOSE - Services
    //  All commands run from workspace root where .env
    //  defines COMPOSE_FILE and COMPOSE_PROFILES
    // ═══════════════════════════════════════════════
    {
      "label": "Docker: Full Setup (first time)",
      "type": "shell",
      "command": "task init",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Docker: Init & Start (build + keycloak + migrations)",
      "type": "shell",
      "command": "docker compose up -d --build --remove-orphans && echo '⏳ Waiting for Keycloak...' && until curl -sf http://localhost:8080/realms/master > /dev/null 2>&1; do sleep 2; done && echo '✅ Keycloak ready' && bash infra/scripts/setup-keycloak.sh --wait --theme --create-org 'ChapsMind Dev' --org-domain chapsmind.local --add-users admin,company_manager,company_viewer,no_access && echo '🗃️ Running migrations...' && docker compose exec screen alembic upgrade head && docker compose exec global-service alembic upgrade head && docker compose exec stream alembic upgrade head && echo '✅ All ready!'",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Docker: Start All Services (up -d --build)",
      "type": "shell",
      "command": "docker compose up -d --build --remove-orphans",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Docker: Stop All Services (down)",
      "type": "shell",
      "command": "docker compose down",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Docker: Restart Service",
      "type": "shell",
      "command": "docker compose restart ${input:service}",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Docker: Rebuild Service",
      "type": "shell",
      "command": "docker compose up -d --build ${input:service}",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Docker: Status (ps)",
      "type": "shell",
      "command": "docker compose ps",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Docker: Full Reset (down + volumes)",
      "type": "shell",
      "command": "echo 'This will delete all data!' && docker compose down -v",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },

    // ═══════════════════════════════════════════════
    //  LOGS
    // ═══════════════════════════════════════════════
    {
      "label": "Logs: Follow Service",
      "type": "shell",
      "command": "docker compose logs -f ${input:service}",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },

    // ═══════════════════════════════════════════════
    //  FRONTEND
    // ═══════════════════════════════════════════════
    {
      "label": "Front: Dev Server (yarn dev)",
      "type": "shell",
      "command": "yarn dev",
      "options": { "cwd": "${workspaceFolder}/apps/front" },
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Front: Run Tests",
      "type": "shell",
      "command": "yarn run test",
      "options": { "cwd": "${workspaceFolder}/apps/front" },
      "group": "test",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Front: Run Tests (watch)",
      "type": "shell",
      "command": "yarn exec vitest",
      "options": { "cwd": "${workspaceFolder}/apps/front" },
      "isBackground": true,
      "group": "test",
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Front: Build",
      "type": "shell",
      "command": "yarn run build",
      "options": { "cwd": "${workspaceFolder}/apps/front" },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Front: Type Check",
      "type": "shell",
      "command": "yarn exec vue-tsc --noEmit",
      "options": { "cwd": "${workspaceFolder}/apps/front" },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Front: Lint & Format",
      "type": "shell",
      "command": "yarn format & yarn stylelint & yarn lint",
      "options": { "cwd": "${workspaceFolder}/apps/front" },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },

    // ═══════════════════════════════════════════════
    //  BACKEND SERVICES (inside Docker)
    // ═══════════════════════════════════════════════
    {
      "label": "Run Tests",
      "type": "shell",
      "command": "docker compose exec ${input:testableService} pytest tests/ -v",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Run Tests (with coverage)",
      "type": "shell",
      "command": "docker compose exec ${input:testableService} pytest tests/ -v --cov=app --cov-report=term-missing",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Shell (bash)",
      "type": "shell",
      "command": "docker compose exec ${input:testableService} bash",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },

    // ═══════════════════════════════════════════════
    //  ALEMBIC MIGRATIONS
    // ═══════════════════════════════════════════════
    {
      "label": "Alembic: Upgrade Head",
      "type": "shell",
      "command": "docker compose exec ${input:migratableService} alembic upgrade head",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Alembic: Current",
      "type": "shell",
      "command": "docker compose exec ${input:migratableService} alembic current",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Alembic: History",
      "type": "shell",
      "command": "docker compose exec ${input:migratableService} alembic history",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Alembic: New Migration",
      "type": "shell",
      "command": "docker compose exec ${input:migratableService} alembic revision -m \"${input:migrationMessage}\"",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Alembic: Downgrade -1",
      "type": "shell",
      "command": "docker compose exec ${input:migratableService} alembic downgrade -1",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },

    // ═══════════════════════════════════════════════
    //  DATABASE
    // ═══════════════════════════════════════════════
    {
      "label": "Database: Connect (psql)",
      "type": "shell",
      "command": "docker compose exec db psql -U postgres -d ${input:database}",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "service",
      "type": "pickString",
      "description": "Which service?",
      "options": [
        "screen",
        "stream",
        "global-service",
        "frontend",
        "nginx",
        "db",
        "keycloak"
      ]
    },
    {
      "id": "testableService",
      "type": "pickString",
      "description": "Which service?",
      "options": [
        "screen",
        "stream",
        "global-service"
      ]
    },
    {
      "id": "migratableService",
      "type": "pickString",
      "description": "Which service?",
      "options": [
        "screen",
        "stream",
        "global-service"
      ]
    },
    {
      "id": "database",
      "type": "pickString",
      "description": "Which database?",
      "options": [
        "chapsmind_db",
        "global_db",
        "stream_db",
        "keycloak"
      ]
    },
    {
      "id": "migrationMessage",
      "type": "promptString",
      "description": "Migration description (e.g., 'add user_preferences table')"
    }
  ]
}
