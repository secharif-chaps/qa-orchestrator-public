# QA Orchestrator — Environment Variables
# Copy to .env and fill in your values

# LLM Gateway (OpenAI-compatible — no direct Anthropic key needed)
LLM_BASE_URL=https://llm-gateway.ai.chapsvision.com/llm-gateway
LLM_API_KEY=your-llm-gateway-key
LLM_MODEL=gpt-5.1-sweden

# GitLab (required for MR analysis workflows)
QA_HUB_GITLAB_HOST=git.mediaspeech.com
QA_HUB_GITLAB_PORT=17890
QA_HUB_GITLAB_TOKEN=glpat-xxxxx

# Jira REST API (terminal mode — generate at https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_BASE_URL=https://chapsvisiondev.atlassian.net
JIRA_EMAIL=you@chapsvision.com
JIRA_TOKEN=your-jira-api-token

# X-Ray Cloud (generate at https://www.getxray.app/xray/settings/api-keys)
# Required for: Gherkin import, Test Executions, Playwright results upload
XRAY_CLIENT_ID=your-xray-client-id
XRAY_CLIENT_SECRET=your-xray-client-secret

# Playwright E2E Testing (for internal API tests)
# Get INTERNAL_JWT_SECRET from your running backend or compose.local.yaml
INTERNAL_JWT_SECRET=local-dev-internal-jwt-secret-32chars
API_BASE_URL=http://localhost/api
PLAYWRIGHT_BASE_URL=http://localhost
PLAYWRIGHT_TIMEOUT=30000
TEST_ORG_ID=12345678-1234-5678-9abc-def012345678
TEST_USER_ID=user-test-001

# Browser Validation (NEW AGENT)
# Set to 'true' to enable live Playwright execution in browserValidator post-hook
BROWSER_VALIDATION_ENABLED=false
