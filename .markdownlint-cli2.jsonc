// markdownlint-cli2 configuration — TAR-1534 / ADR-0016 D7
// Structural lint for Markdown docs. Formatting (wrapping, tables,
// indentation, trailing newlines/spaces) is handled by Prettier — overlapping
// rules are disabled here to avoid double-reporting.
{
  "ignores": ["**/node_modules/**", "**/CHANGELOG.md"],
  "noProgress": true,
  "config": {
    "default": true,

    // ─── Disabled — handled by Prettier ────────────────
    "MD009": false, // no-trailing-spaces
    "MD010": false, // no-hard-tabs
    "MD012": false, // no-multiple-blanks
    "MD013": false, // line-length (Prettier printWidth: 100)
    "MD047": false, // single-trailing-newline

    // ─── Tuned ─────────────────────────────────────────
    "MD024": { "siblings_only": true }, // duplicate headings allowed in different sections
    "MD033": false, // inline HTML — used for <details>, <summary>, <br>
    "MD041": false, // first-line-h1 — some docs start with frontmatter or transcluded content
    "MD046": { "style": "fenced" }, // fenced code blocks only
    "MD048": { "style": "backtick" }, // backtick fences
    "MD049": { "style": "underscore" }, // emphasis with _
    "MD050": { "style": "asterisk" }, // strong with **
  },
}
