// Grafana Alloy configuration for ChapsMind staging environments.
// Collects Docker container logs and ships them to Loki.

// ─── Docker log discovery ────────────────────────────
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "docker_logs" {
  targets = discovery.docker.containers.targets

  // Keep only containers from THIS compose project (e.g. chapsmind-mr-115)
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = env("COMPOSE_PROJECT_NAME")
    action        = "keep"
  }

  // Extract service name from compose label
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  // Extract compose project as environment
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }

  // Extract container name
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  // Add static labels from environment
  rule {
    target_label = "environment"
    replacement  = env("ENV_NAME_SLUG")
  }

  rule {
    target_label = "project"
    replacement  = "chapsmind"
  }
}

// ─── Log collection ──────────────────────────────────
loki.source.docker "containers" {
  host    = "unix:///var/run/docker.sock"
  targets = discovery.relabel.docker_logs.output

  forward_to    = [loki.process.pipeline.receiver]
  refresh_interval = "5s"
}

// ─── Log processing pipeline ─────────────────────────
loki.process "pipeline" {
  // Detect and parse JSON logs (FastAPI, uvicorn)
  stage.json {
    expressions = {
      level   = "levelname",
      logger  = "name",
      message = "message",
    }
  }

  // Promote extracted fields to Loki labels
  stage.labels {
    values = {
      level  = "level",
      logger = "logger",
    }
  }

  // Replace raw JSON line with the extracted message for readability in Grafana
  stage.output {
    source = "message"
  }

  forward_to = [loki.write.default.receiver]
}

// ─── Loki output ─────────────────────────────────────
loki.write "default" {
  // Internal CA cert for *.localnet is mounted to /etc/ssl/certs/localnet-ca.crt
  // and trusted via the container's default cert store.
  endpoint {
    url = env("LOKI_PUSH_URL")
  }

  external_labels = {
    environment = env("ENV_NAME_SLUG"),
    project     = "chapsmind",
  }
}