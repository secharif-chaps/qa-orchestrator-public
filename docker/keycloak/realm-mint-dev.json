{
  "realm": "mint-dev",
  "displayName": "mint - Dev",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "resetPasswordAllowed": true,
  "verifyEmail": true,
  "loginTheme": "mint",
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Chuck",
      "lastName": "NORRIS",
      "email": "admin@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "password"
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "mint-back",
      "name": "Mint BackEnd Application",
      "enabled": true,
      "baseUrl": "http://localhost:8000",
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "publicClient": true
    },
    {
      "clientId": "mint-front",
      "name": "Mint FrontEnd Application",
      "enabled": true,
      "baseUrl": "http://localhost:3000",
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "publicClient": true,
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:3000",
