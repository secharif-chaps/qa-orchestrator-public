{
  "realm": "mint-dev",
  "displayName": "mint - Dev",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "resetPasswordAllowed": true,
  "verifyEmail": true,
  "loginTheme": "mint",
  "users": [
    {
      "username": "keycloak-admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Keycloak",
      "lastName": "Admin",
      "email": "keycloak-admin@mint.dev",
      "credentials": [
        {
          "type": "password",
          "value": "admin123"
        }
      ],
      "realmRoles": ["admin"]
    }
  ],
  "clients": [
    {
      "clientId": "mint-back",
      "name": "Mint BackEnd Application",
      "enabled": true,
      "baseUrl": "http://localhost:8000",
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false
    },
    {
      "clientId": "mint-front",
      "name": "Mint FrontEnd Application",
      "enabled": true,
      "baseUrl": "http://10.0.1.2:3000",
      "redirectUris": ["http://10.0.1.2:3000/*", "http://localhost:3000/*"],
      "webOrigins": ["http://10.0.1.2:3000", "http://localhost:3000"],
      "publicClient": true,
      "attributes": {
        "post.logout.redirect.uris": "http://10.0.1.2:3000/*##http://localhost:3000/*"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic",
        "email"
      ]
    },
    {
      "clientId": "admin-cli",
      "name": "Admin CLI",
      "description": "Admin CLI for backend service account access",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "secret": "admin-cli-secret",
      "protocolMappers": [
        {
          "name": "Client ID",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "consentRequired": false,
          "config": {
            "user.session.note": "clientId",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "clientId",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
  "internationalizationEnabled": true,
  "supportedLocales": ["en", "fr"],
  "defaultLocale": "en",
  "roles": {
    "realm": [
      {
        "name": "workspace.read",
        "description": "Read access to user's own workspace",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "workspace.write", 
        "description": "Write access to user's own workspace",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "company.view",
        "description": "View companies in user's workspace",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "company.create",
        "description": "Create companies in user's workspace", 
        "composite": false,
        "clientRole": false
      },
      {
        "name": "company.delete",
        "description": "Delete companies in user's workspace",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "admin.workspaces",
        "description": "Global administrative access to all workspaces",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "admin",
        "description": "Full administrative access (composite role)",
        "composite": true,
        "composites": {
          "realm": [
            "workspace.read",
            "workspace.write", 
            "company.view",
            "company.create",
            "company.delete",
            "admin.workspaces"
          ]
        },
        "clientRole": false
      }
    ]
  },
  "clientScopeMappings": {
    "admin-cli": [
      {
        "client": "realm-management",
        "roles": [
          "realm-admin",
          "manage-users",
          "view-users",
          "query-users",
          "create-client",
          "manage-clients",
          "view-clients"
        ]
      }
    ]
  }
}