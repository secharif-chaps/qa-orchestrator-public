# LLM Gateway Configuration
# Copy this file to .env and fill in your values before running evaluations.

# API key — uses standard OPENAI_API_KEY so the OpenAI provider auto-detects it
LLM_GATEWAY_API_KEY=<tbd>

# Base URL for the OpenAI-compatible endpoint (no trailing slash)
LLM_GATEWAY_BASE_URL=<tbd>


# ── Judge model for llm-rubric assertions ────────────────────────────────────
LLM_RUBRIC_MODEL=gpt-4o-mini-sweden
