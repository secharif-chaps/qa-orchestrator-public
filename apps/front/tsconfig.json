{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue", "./typed-router.d.ts"],
  "exclude": ["src/**/__tests__/*", "src/**/server/**"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "noEmit": true,
    "skipLibCheck": true,

    "paths": {
      "@/*": ["./src/*"],
      "@target/*": ["./src/target/*"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": []
  }
}
