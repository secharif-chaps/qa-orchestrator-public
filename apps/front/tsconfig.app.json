{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue", "./typed-router.d.ts"],
  "exclude": ["src/**/__tests__/*", "src/target/**/*", "src/pages/target/**/*"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "noEmit": true,

    "paths": {
      "@/*": ["./src/*"],
      "@target/*": ["./src/target/*"]
    },
    "types": []
  }
}
