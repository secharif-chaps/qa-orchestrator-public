{
  "type": "basil",
  "license": "proprietary",
  "require": {
    "php": "~8.4.0",
    "ext-bcmath": "*",
    "ext-ctype": "*",
    "ext-curl": "*",
    "ext-iconv": "*",
    "ext-pcntl": "*",
    "ext-sodium": "*",
    "ext-xsl": "*",
    "api-platform/doctrine-orm": "^4.3.0",
    "api-platform/elasticsearch": "4.3.0",
    "api-platform/symfony": "^4.3.0",
    "doctrine/doctrine-bundle": "^3.0",
    "doctrine/doctrine-migrations-bundle": "^4.0",
    "doctrine/orm": "^3.0",
    "enshrined/svg-sanitize": "^0.22.0",
    "firebase/php-jwt": "^7.0",
    "league/commonmark": "^2.7",
    "nelmio/cors-bundle": "^2.2",
    "nyholm/psr7": "^1.8.2",
    "opensearch-project/opensearch-php": "^2.5",
    "patrickschur/language-detection": "^5.3.1",
    "phpdocumentor/reflection-docblock": "^5.2",
    "phpstan/phpdoc-parser": "^2.0",
    "phrity/websocket": "^3.6",
    "predis/predis": "^3.0",
    "runtime/frankenphp-symfony": "1.0.0",
    "sentry/sentry-symfony": "^5.8",
    "symfony/amqp-messenger": "7.4.*",
    "symfony/asset": "7.4.*",
    "symfony/console": "7.4.*",
    "symfony/doctrine-messenger": "7.4.*",
    "symfony/dotenv": "7.4.*",
    "symfony/expression-language": "7.4.*",
    "symfony/flex": "^2.2",
    "symfony/framework-bundle": "7.4.*",
    "symfony/intl": "7.4.*",
    "symfony/mailer": "7.4.*",
    "symfony/mercure-bundle": "^0.4.0",
    "symfony/messenger": "7.4.*",
    "symfony/monolog-bundle": "^3.8",
    "symfony/notifier": "7.4.*",
    "symfony/property-access": "7.4.*",
    "symfony/property-info": "7.4.*",
    "symfony/rate-limiter": "7.4.*",
    "symfony/runtime": "7.4.*",
    "symfony/scheduler": "7.4.*",
    "symfony/security-bundle": "7.4.*",
    "symfony/serializer": "7.4.*",
    "symfony/translation": "7.4.*",
    "symfony/twig-bundle": "7.4.*",
    "symfony/type-info": "7.4.*",
    "symfony/validator": "7.4.*",
    "symfony/yaml": "7.4.*",
    "twig/cssinliner-extra": "^3.21",
    "twig/extra-bundle": "^2.12|^3.0",
    "twig/inky-extra": "^3.21",
    "twig/markdown-extra": "^3.21",
    "twig/twig": "^2.12|^3.0",
    "webmozart/assert": "^2.0",
    "wikimedia/textcat": "^2.0"
  },
  "require-dev": {
    "api-platform/schema-generator": "^5.0",
    "dama/doctrine-test-bundle": "^8.3",
    "dg/bypass-finals": "^1.9",
    "doctrine/doctrine-fixtures-bundle": "^4.1",
    "justinrainbow/json-schema": "^6.4",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-doctrine": "^2.0",
    "phpstan/phpstan-symfony": "^2.0",
    "phpunit/phpunit": "^12.5.8",
    "rector/rector": "^2.3",
    "symfony/browser-kit": "7.4.*",
    "symfony/css-selector": "7.4.*",
    "symfony/debug-bundle": "7.4.*",
    "symfony/maker-bundle": "^1.44",
    "symfony/phpunit-bridge": "8.0.*",
    "symfony/stopwatch": "7.4.*",
    "symfony/var-dumper": "7.4.*",
    "symfony/web-profiler-bundle": "7.4.*",
    "symplify/easy-coding-standard": "^12.5",
    "zenstruck/foundry": "^2.6",
    "zenstruck/messenger-test": "^1.12"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": {
      "*": "dist"
    },
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true,
      "symfony/flex": true,
      "symfony/runtime": true
    }
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "replace": {
    "paragonie/random_compat": "2.*",
    "symfony/polyfill-ctype": "*",
    "symfony/polyfill-iconv": "*",
    "symfony/polyfill-intl-grapheme": "*",
    "symfony/polyfill-intl-normalizer": "*",
    "symfony/polyfill-mbstring": "*",
    "symfony/polyfill-php84": "*",
    "symfony/polyfill-php83": "*",
    "symfony/polyfill-php82": "*",
    "symfony/polyfill-php81": "*",
    "symfony/polyfill-php80": "*"
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    },
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ]
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "7.4.*",
      "docker": false
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
