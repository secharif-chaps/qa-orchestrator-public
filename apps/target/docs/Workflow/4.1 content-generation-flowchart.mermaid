flowchart TD
    subgraph Generation["Génération de Contenu Adapté (Phase 4.1)"]
        START([Insights de la phase 3.3]) --> INPUT[/Insights avec patterns et prédictions/]
        
        subgraph Transformation["Intelligence de Transformation de Contenu"]
            INPUT --> A1[Agent IA de Synthèse Automatique]
            A1 --> A2[Agent IA de Structuration de Contenu]
            A2 --> A3[Agent IA d'Adaptation aux Formats]
            A3 --> BRANCH{Spécialisation\npar type\nde veille}
        end
        
        BRANCH -->|Veille Concurrentielle| B1
        BRANCH -->|Veille Stratégique| C1
        BRANCH -->|Veille Commerciale| D1
        BRANCH -->|Veille Technologique| E1
        BRANCH -->|Veille Juridique| F1
        
        subgraph ContentConc["Intelligence de Contenu Concurrentiel"]
            B1[Agent IA de Génération de Fiches Concurrentielles]
            B1 --> B2[Agent IA de Création de Benchmarks]
            B2 --> B3[Agent IA de Cartographie Dynamique]
            B3 --> MERGE
        end
        
        subgraph ContentStrat["Intelligence de Contenu Stratégique"]
            C1[Agent IA de Génération de Rapports de Tendances]
            C1 --> C2[Agent IA de Création de Scénarios Prospectifs]
            C2 --> C3[Agent IA de Cartographie d'Impact Stratégique]
            C3 --> MERGE
        end
        
        subgraph ContentCom["Intelligence de Contenu Commercial"]
            D1[Agent IA de Génération de Fiches Prospect]
            D1 --> D2[Agent IA de Création de Battle Cards]
            D2 --> D3[Agent IA de Scripts d'Objection]
            D3 --> MERGE
        end
        
        subgraph ContentTech["Intelligence de Contenu Technologique"]
            E1[Agent IA de Génération de Radar Technologique]
            E1 --> E2[Agent IA de Création de Fiches Techniques]
            E2 --> E3[Agent IA de Roadmaps Comparatives]
            E3 --> MERGE
        end
        
        subgraph ContentJur["Intelligence de Contenu Juridique"]
            F1[Agent IA de Génération de Bulletins Réglementaires]
            F1 --> F2[Agent IA de Création de Guides de Conformité]
            F2 --> F3[Agent IA de Calendriers d'Application]
            F3 --> MERGE
        end
        
        MERGE{Intégration\ndes contenus\nspécialisés}
        
        MERGE --> G1
        
        subgraph Perso["Intelligence de Personnalisation"]
            G1[Agent IA d'Adaptation au Profil Utilisateur]
            G1 --> G2[Agent IA de Génération Visuelle]
            G2 --> G3[Agent IA de Narration Explicative]
            G3 --> G4[Agent IA d'Interactivité Contextuelle]
        end
        
        G4 --> OUTPUT[/Contenu à forte valeur ajoutée personnalisé/]
        OUTPUT --> END([Passage à la phase 4.2])
    end
    
    %% Styles améliorés avec meilleur contraste
    classDef intelligence fill:#8a2be2,stroke:#000,stroke-width:2px,color:#fff
    classDef process fill:#4682b4,stroke:#000,stroke-width:1px,color:#fff
    classDef document fill:#f5a742,stroke:#000,stroke-width:1px,color:#000
    classDef decision fill:#d81b60,stroke:#000,stroke-width:1px,color:#fff
    classDef subgraphStyle fill:#f5f5f5,stroke:#333,stroke-width:1px
    
    %% Application des styles
    class A1,A2,A3,B1,B2,B3,C1,C2,C3,D1,D2,D3,E1,E2,E3,F1,F2,F3,G1,G2,G3,G4 intelligence
    class START,END process
    class INPUT,OUTPUT document
    class BRANCH,MERGE decision
    class Transformation,ContentConc,ContentStrat,ContentCom,ContentTech,ContentJur,Perso subgraphStyle