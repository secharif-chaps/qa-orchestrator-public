flowchart TD
    subgraph Analyse["Analyse des Objectifs (Phase 1.1)"]
        START([Démarrage du processus]) --> INPUT[/Saisie des besoins initiaux par l'utilisateur/]

        subgraph Identification["Intelligence d'Identification et Cadrage"]
            INPUT --> A1[Agent IA d'Analyse des Besoins - Prompt: analyze_user_needs]
            A1 --> A2[Agent IA de Formalisation des Questions Stratégiques - Prompt: strategic_questions_formalization]
            A2 --> A4[TODO : Agent IA de sous Question Google]
            A4 --> A5[TODO : Scrap result from Google]
            A5 --> A6[TODO : Agent IA de filtrage des URL pertinentes pour répondre aux questions/besoin]
            A6 -->|Itération x3| A1
            A6 --> A9[TODO : Agent IA - Analyse des résultats de la recherche et formulation de la query]
            A6 --> A3[TODO : Agent IA de Cadrage Temporel]
            A3 --> A7[TODO : Detection des acteurs]
            A7 --> A8[TODO : Detection de sources pertinentes]
            A9 --> DETECT{Détection du type de veille principal - Prompt: detect_monitoring_type}
        end

        DETECT -->|Veille Concurrentielle| B1
        DETECT -->|Veille Stratégique| C1
        DETECT -->|Veille Commerciale| D1
        DETECT -->|Veille Technologique| E1
        DETECT -->|Veille Juridique| F1

        subgraph Concurrentielle["Intelligence Concurrentielle"]
            B1[TODO] --> MERGE
        end

        subgraph Strategique["Intelligence Stratégique"]
            C1[TODO] --> MERGE
        end

        subgraph Commerciale["Intelligence Commerciale"]
            D1[TODO] --> MERGE
        end

        subgraph Technologique["Intelligence Technologique"]
            E1[TODO] --> MERGE
        end

        subgraph Juridique["Intelligence Juridique"]
            F1[TODO] --> MERGE
        end

        MERGE{Fusion etintégration desanalyses spécifiques}

        MERGE --> G1

        subgraph Synthese["Intelligence de Synthèse et Configuration"]
            G1[TODO : Agent IA de Définition des KPIs]
        end

        G1 --> OUTPUT[/Document de cadrage finalisé/]
        OUTPUT --> END([Passage à la phase suivante])
    end

    %% Styles améliorés avec meilleur contraste
    classDef intelligence fill:#8a2be2,stroke:#000,stroke-width:2px,color:#fff
    classDef process fill:#4682b4,stroke:#000,stroke-width:1px,color:#fff
    classDef document fill:#f5a742,stroke:#000,stroke-width:1px,color:#000
    classDef decision fill:#d81b60,stroke:#000,stroke-width:1px,color:#fff
    classDef subgraphStyle fill:#f5f5f5,stroke:#333,stroke-width:1px

    %% Application des styles
    class A1,A2,A3,B1,B2,B3,C1,C2,C3,D1,D2,D3,E1,E2,E3,F1,F2,F3,G1,G2,G3,G4 intelligence
    class START,END process
    class INPUT,OUTPUT document
    class DETECT,MERGE decision
    class Identification,Concurrentielle,Strategique,Commerciale,Technologique,Juridique,Synthese subgraphStyle
