{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://basil.local/schemas/n8n-test-dataset.schema.json",
  "title": "N8N Test Dataset",
  "description": "Schema for N8N workflow test datasets with input/output validation",
  "type": "object",
  "required": ["version", "metadata", "testCases"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "description": "Dataset format version",
      "pattern": "^\\d+\\.\\d+$",
      "examples": ["1.0", "2.0"]
    },
    "metadata": {
      "type": "object",
      "description": "Dataset metadata including workflow information and normalization config",
      "required": ["workflowId", "workflowName", "description"],
      "additionalProperties": false,
      "properties": {
        "workflowId": {
          "type": "string",
          "description": "N8N workflow ID (auto-detected by test runner)",
          "minLength": 1,
          "examples": ["HLe3ZYDy6oiBINzb", "N87xE62THnkDjs2x"]
        },
        "workflowName": {
          "type": "string",
          "description": "Human-readable workflow name",
          "minLength": 1,
          "examples": ["3. Tool - WatchFile Builder", "3.a WatchFile Builder - Add Actor"]
        },
        "description": {
          "type": "string",
          "description": "Dataset purpose and scope description",
          "minLength": 1
        },
        "snapshotNormalization": {
          "type": "object",
          "description": "Configuration for snapshot normalization (removes volatile fields)",
          "additionalProperties": false,
          "properties": {
            "removeFields": {
              "type": "array",
              "description": "Array of field paths to remove before snapshot comparison (supports wildcards)",
              "items": {
                "type": "string",
                "pattern": "^[\\*\\.\\w]+$",
                "examples": ["*.context", "*.context.execution", "_testMetadata"]
              },
              "minItems": 1,
              "default": [
                "*.context.execution",
                "*.context.timestamp",
                "*.context.messageId",
                "*.context.conversationId",
                "_testMetadata"
              ]
            }
          }
        }
      }
    },
    "testCases": {
      "type": "array",
      "description": "Array of test cases to execute",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "testCaseId",
          "name",
          "description",
          "expectedBehavior",
          "expectedOutput",
          "input"
        ],
        "additionalProperties": false,
        "properties": {
          "testCaseId": {
            "type": "string",
            "description": "Unique test case identifier (used for filtering and reporting)",
            "pattern": "^TC-\\d{3,}$",
            "examples": ["TC-001", "TC-042"]
          },
          "name": {
            "type": "string",
            "description": "Short descriptive test case name",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "description": "Detailed test case description",
            "minLength": 1
          },
          "expectedBehavior": {
            "type": "string",
            "description": "Expected workflow behavior and routing logic",
            "minLength": 1
          },
          "expectedOutput": {
            "type": "string",
            "description": "Expected output description (used for test evaluation: 'success', 'error', 'notrelevant')",
            "minLength": 1
          },
          "input": {
            "type": "object",
            "description": "Input payload sent to webhook (workflow-specific structure)",
            "minProperties": 1
          },
          "snapshot": {
            "description": "Expected response snapshot for regression testing (null for new tests)",
            "oneOf": [{ "type": "null" }, { "type": "object" }, { "type": "array" }]
          },
          "successCheck": {
            "type": "object",
            "description": "Optional custom success validation configuration",
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean",
                "description": "Enable/disable success field checking",
                "default": true
              },
              "expectedPathValue": {
                "type": "array",
                "description": "Array of [path, expectedValue] pairs to check for success state",
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": [
                    {
                      "type": "string",
                      "description": "Dot-notation path to field (e.g., 'actor.success', 'success')"
                    },
                    {
                      "description": "Expected value at that path"
                    }
                  ]
                },
                "minItems": 1,
                "default": [["success", true]]
              }
            }
          },
          "responseSchema": {
            "type": "object",
            "description": "Optional JSON Schema for validating response structure",
            "$comment": "Standard JSON Schema draft-07 format"
          }
        }
      }
    }
  }
}
