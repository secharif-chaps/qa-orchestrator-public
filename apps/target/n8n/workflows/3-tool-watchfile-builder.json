    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  // Helper: parse JSON string safely\n  const safeJsonParse = (value) => {\n    if (typeof value === 'string') {\n      try {\n        return JSON.parse(value);\n      } catch (e) {\n        return value; // Not valid JSON, keep original\n      }\n    }\n    return value; // Already parsed or not a string\n  };\n\n  // Parse watchFile\n  if (item.json?.watchFile) {\n    item.json.watchFile = safeJsonParse(item.json.watchFile);\n  }\n\n  // Parse actor\n  if (item.json?.actor) {\n    item.json.actor = safeJsonParse(item.json.actor);\n  } else if (item.json?.actor === '') {\n    item.json.actor = null;\n  }\n\n  // Parse source\n  if (item.json?.source) {\n    item.json.source = safeJsonParse(item.json.source);\n  } else if (item.json?.source === '') {\n    item.json.source = null;\n  }\n\n  // Parse referenceSubject\n  if (item.json?.referenceSubject === '') {\n    item.json.referenceSubject = null;\n  }\n\n  // Parse context\n  if (item.json?.context) {\n    item.json.context = safeJsonParse(item.json.context);\n\n    if (typeof item.json.context.BusNameStamp !== 'string') {\n      item.json.context.BusNameStamp = JSON.stringify(item.json.context.BusNameStamp);\n    }\n\n    if (typeof item.json.context.RouterContextStamp !== 'string') {\n      item.json.context.RouterContextStamp = JSON.stringify(item.json.context.RouterContextStamp);\n    }\n  }\n\n  // Parse sourceTypes\n  if (item.json?.sourceTypes) {\n    item.json.sourceTypes = safeJsonParse(item.json.sourceTypes);\n  }\n\n  // Parse collectors\n  if (item.json?.collectors) {\n    item.json.collectors = safeJsonParse(item.json.collectors);\n  }\n\n  // Default language\n  item.json.language = item.json?.language || 'en';\n}\n\nreturn $input.all();"
      },
