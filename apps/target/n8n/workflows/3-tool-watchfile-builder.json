      "parameters": {
        "jsCode": "function getNodeData(nodeName) {\n  try {\n    const items = $(nodeName).all();\n    return items.length > 0 ? $(nodeName).last().json : null;\n  } catch (error) {\n    return null;\n  }\n}\n\nfunction flattenObject(key, data) {\n  if (data && data.hasOwnProperty(key)) {\n    return data[key];\n  }\n  return data;\n}\n\nfunction getNodeValue(key, errorNodeName, successNodeName) {\n  const error = getNodeData(errorNodeName);\n  if (error !== null) {\n    const result = {[key]: flattenObject(key, error)};\n    return result;\n  }\n  \n  const feedback = getNodeData(successNodeName);\n  if (feedback !== null) {\n    const result = {[key]: flattenObject(key, feedback)};\n    return result;\n  }\n  return null;\n}\n\nconst result = {\n  actor: null,\n  source: null,\n  referenceSubject: null,\n  ...getNodeValue('actor', 'Feedback_ActorWorkflowError', 'Workflow_Call_AddActor'),\n  ...getNodeValue('source', 'Feedback_SourceWorkflowError', 'Workflow_Call_AddSource'),\n  ...getNodeValue('referenceSubject', 'Feedback_UpdateReferenceSubjectWorkflowError', 'Workflow_Call_UpdateReferenceSubject')\n};\n\nreturn result;"
      },
