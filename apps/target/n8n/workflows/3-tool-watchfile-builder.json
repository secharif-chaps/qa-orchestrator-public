      "parameters": {
        "jsCode": "/**\n * Calculate Levenshtein distance between two strings\n * @param {string} str1 - First string\n * @param {string} str2 - Second string\n * @returns {number} - Levenshtein distance\n */\nfunction levenshteinDistance(str1, str2) {\n  const len1 = str1.length;\n  const len2 = str2.length;\n  \n  // Create matrix\n  const matrix = Array(len1 + 1).fill(null).map(() => Array(len2 + 1).fill(0));\n  \n  // Initialize first column and row\n  for (let i = 0; i <= len1; i++) matrix[i][0] = i;\n  for (let j = 0; j <= len2; j++) matrix[0][j] = j;\n  \n  // Fill matrix\n  for (let i = 1; i <= len1; i++) {\n    for (let j = 1; j <= len2; j++) {\n      const cost = str1[i - 1] === str2[j - 1] ? 0 : 1;\n      matrix[i][j] = Math.min(\n        matrix[i - 1][j] + 1,      // deletion\n        matrix[i][j - 1] + 1,      // insertion\n        matrix[i - 1][j - 1] + cost // substitution\n      );\n    }\n  }\n  \n  return matrix[len1][len2];\n}\n\n/**\n * Calculate similarity percentage between two strings\n * @param {string} str1 - First string\n * @param {string} str2 - Second string\n * @returns {number} - Similarity percentage (0-100)\n */\nfunction similarity(str1, str2) {\n  const distance = levenshteinDistance(str1.toLowerCase(), str2.toLowerCase());\n  const maxLength = Math.max(str1.length, str2.length);\n  return ((maxLength - distance) / maxLength) * 100;\n}\n\n/**\n * Check if two strings are duplicates\n * @param {string} str1 - First string\n * @param {string} str2 - Second string\n * @param {number} distanceThreshold - Max Levenshtein distance (default: 3)\n * @param {number} similarityThreshold - Min similarity percentage (default: 85)\n * @returns {boolean} - True if duplicate detected\n */\nfunction isDuplicate(str1, str2, distanceThreshold = 3, similarityThreshold = 85) {\n  // Add null/undefined checks\n  if (!str1 || !str2) return false;\n  \n  const distance = levenshteinDistance(str1.toLowerCase(), str2.toLowerCase());\n  const sim = similarity(str1, str2);\n  \n  return distance < distanceThreshold || sim > similarityThreshold;\n}\n\nconst items = $input.all();\n\nitems.forEach(item => {\n  const data = item.json;\n  \n  // Check actor duplicates\n  if (data.actor && data.watchFile?.watchFileActors) {\n    const newLabel = data.actor.label;\n    const existingActors = data.watchFile.watchFileActors;\n    \n    // Add safety check for label existence\n    const duplicateFound = existingActors.filter(existing => {\n      if (!existing?.actor?.label || !newLabel) return false;\n      return isDuplicate(newLabel, existing.actor.label);\n    });\n\n    item.json.actor.duplicates = duplicateFound;\n    item.json.actor.isDuplicated = duplicateFound.length > 0;\n  }\n  \n  // Check source duplicates\n  if (data.source && data.watchFile?.sources) {\n    const newUrl = data.source.url;\n    const newDomain = data.source.primaryDomain;\n    const newQuery = data.source.query;\n    \n    const duplicateFound = data.watchFile.sources.filter(existing => {\n      // Add null checks for all comparisons\n      if (!existing) return false;\n      \n      // Only exact URL match counts as duplicate\n      if (newUrl && existing.url && existing.url === newUrl) return true;\n      \n      return false;\n    });\n    \n    item.json.source.duplicates = duplicateFound;\n    item.json.source.isDuplicated = duplicateFound.length > 0;\n  }\n});\n\nreturn items;"
      },
