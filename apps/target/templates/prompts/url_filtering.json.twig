{
    "type": "OBJECT",
    "properties": {
        "filteredUrls": {
            "type": "ARRAY",
            "items": {
                "type": "OBJECT",
                "properties": {
                    "url": {
                        "type": "STRING",
                        "format": "uri"
                    },
                    "title": {
                        "type": "STRING",
                        "maxLength": 200
                    },
                    "relevanceScore": {
                        "type": "NUMBER",
                        "minimum": 0,
                        "maximum": 100
                    },
                    "relevanceJustification": {
                        "type": "OBJECT",
                        "properties": {
                            "fr": {
                                "type": "STRING",
                                "maxLength": 500
                            },
                            "en": {
                                "type": "STRING",
                                "maxLength": 500
                            }
                        }
                    },
                    "competitorsIdentified": {
                        "type": "ARRAY",
                        "items": {
                            "type": "STRING"
                        }
                    },
                    "competitiveInsights": {
                        "type": "ARRAY",
                        "items": {
                            "type": "STRING",
                            "enum": ["pricing_strategy", "market_expansion", "product_launch", "technology_adoption", "partnership", "acquisition", "marketing_campaign", "customer_segment", "geographic_focus", "other"]
                        }
                    },
                    "sourceQuality": {
                        "type": "STRING",
                        "enum": ["high", "medium", "low"]
                    }
                },
                "required": ["url", "title", "relevanceScore", "relevanceJustification"]
            }
        },
        "rejectedUrls": {
            "type": "ARRAY",
            "items": {
                "type": "OBJECT",
                "properties": {
                    "url": {
                        "type": "STRING",
                        "format": "uri"
                    },
                    "rejectionReason": {
                        "type": "STRING",
                        "maxLength": 300
                    }
                },
                "required": ["url", "rejectionReason"]
            }
        },
        "filteringSummary": {
            "type": "OBJECT",
            "properties": {
                "totalUrlsEvaluated": {
                    "type": "INTEGER"
                },
                "urlsAccepted": {
                    "type": "INTEGER"
                },
                "urlsRejected": {
                    "type": "INTEGER"
                },
                "averageRelevanceScore": {
                    "type": "NUMBER"
                },
                "competitorCoverage": {
                    "type": "OBJECT",
                    "additionalProperties": {
                        "type": "INTEGER"
                    }
                }
            },
            "required": ["totalUrlsEvaluated", "urlsAccepted", "urlsRejected", "averageRelevanceScore"]
        },
        "confidence": {
            "type": "NUMBER",
            "minimum": 0,
            "maximum": 100
        }
    },
    "required": ["filteredUrls", "rejectedUrls", "filteringSummary", "confidence"]
}