{
    "description": "A structured set of source recommendations based on client needs analysis",
    "type": "OBJECT",
    "required": ["source_evaluation", "sources"],
    "properties": {
        "source_evaluation": {
            "type": "OBJECT",
            "description": "Analysis of the client's request and evaluation of relevant information sources",
            "required": ["key_elements", "specific_information", "contextual_factors", "significant_actors"],
            "properties": {
                "key_elements": {
                    "type": "ARRAY",
                    "description": "Key elements identified from the client's request title",
                    "items": { "type": "STRING" }
                },
                "specific_information": {
                    "type": "ARRAY",
                    "description": "Specific information points sought in the client's query",
                    "items": { "type": "STRING" }
                },
                "contextual_factors": {
                    "type": "ARRAY",
                    "description": "Contextual factors that influence the selection of information sources",
                    "items": { "type": "STRING" }
                },
                "significant_actors": {
                    "type": "ARRAY",
                    "description": "Important entities (e.g., competitors, suppliers, regulators) mentioned in the request",
                    "items": { "type": "STRING" }
                }
            }
        },
        "sources": {
            "type": "ARRAY",
            "description": "List of recommended information sources based on the client's needs",
            "items": {
                "type": "OBJECT",
                "description": "Configuration for an individual information source",
                "required": ["watchfileId", "name", "type", "primary_domain", "url", "query", "description", "relevance"],
                "properties": {
                    "name": {
                        "type": "STRING",
                        "description": "Descriptive name for the information source"
                    },
                    "type": {
                        "type": "STRING",
                        "description": "Category of the information source",
                        "enum": {{ sourceTypes|json_encode|raw }}
                    },
                    "primary_domain": {
                        "type": "STRING",
                        "description": "Main domain name of the source (e.g., 'linkedin.com', 'twitter.com'), used for display a logo or icon"
                    },
                    "url": {
                        "type": "STRING",
                        "description": "Full URL address of the information source"
                    },
                    "query": {
                        "type": "STRING",
                        "description": "Search query or filter string to retrieve specific information from the source"
                    },
                    "description": {
                        "type": "OBJECT",
                        "description": "Multilingual description of the information source",
                        "required": ["en", "fr"],
                        "properties": {
                            "en": {
                                "type": "STRING",
                                "description": "English description of the source"
                            },
                            "fr": {
                                "type": "STRING",
                                "description": "French description of the source"
                            }
                        }
                    },
                    "relevance": {
                        "type": "OBJECT",
                        "description": "Multilingual explanation of why this source is relevant to the client's needs",
                        "required": ["en", "fr"],
                        "properties": {
                            "en": {
                                "type": "STRING",
                                "description": "Explanation of relevance in English"
                            },
                            "fr": {
                                "type": "STRING",
                                "description": "Explanation of relevance in French"
                            }
                        }
                    },
                    "parameters": {
                        "type": "ARRAY",
                        "description": "Additional configuration parameters specific to this type of source",
                        "items": {
                            "type": "OBJECT",
                            "properties": {
                                "key": {
                                    "type": "STRING",
                                    "description": "Parameter name"
                                },
                                "value": {
                                    "type": "STRING",
                                    "description": "Parameter value"
                                }
                            },
                            "required": ["key", "value"]
                        }
                    }
                }
            }
        }
    }
}
