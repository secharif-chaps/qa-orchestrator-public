{
    "description": "A structured analysis of actors relevant to a business intelligence context",
    "type": "OBJECT",
    "required": ["actors"],
    "properties": {
        "actors": {
            "type": "ARRAY",
            "description": "List of actors recommended for monitoring",
            "items": {
                "type": "OBJECT",
                "description": "Details of an individual actor recommended for monitoring",
                "required": ["name", "primary_domain", "relevance", "score", "type"],
                "properties": {
                    "name": {
                        "type": "OBJECT",
                        "description": "Multilingual name of the actor",
                        "required": ["fr", "en"],
                        "properties": {
                            "fr": {
                                "type": "STRING",
                                "description": "French name of the actor"
                            },
                            "en": {
                                "type": "STRING",
                                "description": "English name of the actor"
                            }
                        }
                    },
                    "primary_domain": {
                        "type": "STRING",
                        "description": "Primary website domain name of the actor"
                    },
                    "relevance": {
                        "type": "OBJECT",
                        "description": "Multilingual explanation of why this actor is relevant",
                        "required": ["en", "fr"],
                        "properties": {
                            "en": {
                                "type": "STRING",
                                "description": "Explanation of relevance in English"
                            },
                            "fr": {
                                "type": "STRING",
                                "description": "Explanation of relevance in French"
                            }
                        }
                    },
                    "score": {
                        "type": "NUMBER",
                        "description": "Relevance score of the actor"
                    },
                    "type": {
                        "type": "STRING",
                        "description": "Category of the actor",
                        "enum": ["competitor", "supplier", "regulator", "industry_expert"]
                    }
                }
            }
        }
    }
}
