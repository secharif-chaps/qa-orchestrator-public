{% extends '@!ApiPlatform/SwaggerUi/index.html.twig' %}

{% block title %}
    <title>{% if title %}{{ title }} - {% endif %}API Documentation</title>
{% endblock %}

{% block stylesheet %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('api-assets/swagger-custom.css') }}">
{% endblock %}

{% block header %}
    <header>
        <div id="logo-container">
            <span class="logo-text">{{ title|default('Target') }}</span>
            <span class="logo-subtitle">API Documentation</span>
        </div>
    </header>
{% endblock %}
