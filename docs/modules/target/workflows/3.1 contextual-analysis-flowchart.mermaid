flowchart TD
    subgraph AnalyseCont["Analyse Contextuelle et Sémantique (Phase 3.1)"]
        START([Données brutes collectées de la phase 2.2]) --> INPUT[/Données structurées et métadonnées/]
        
        subgraph AnalyseFonda["Intelligence d'Analyse Fondamentale"]
            INPUT --> A1[Agent IA d'Extraction d'Entités Nommées]
            A1 --> A2[Agent IA d'Analyse Sémantique Profonde]
            A2 --> A3[Agent IA de Catégorisation Thématique]
            A3 --> BRANCH{Spécialisation\npar type\nde veille}
        end
        
        BRANCH -->|Veille Concurrentielle| B1
        BRANCH -->|Veille Stratégique| C1
        BRANCH -->|Veille Commerciale| D1
        BRANCH -->|Veille Technologique| E1
        BRANCH -->|Veille Juridique| F1
        
        subgraph AnalyseConc["Intelligence d'Analyse Concurrentielle"]
            B1[Agent IA d'Analyse de Positionnement]
            B1 --> B2[Agent IA d'Extraction de Proposition de Valeur]
            B2 --> B3[Agent IA de Détection d'Avantages Compétitifs]
            B3 --> MERGE
        end
        
        subgraph AnalyseStrat["Intelligence d'Analyse Stratégique"]
            C1[Agent IA d'Analyse de Tendances Corrélées]
            C1 --> C2[Agent IA d'Extraction de Scénarios Prospectifs]
            C2 --> C3[Agent IA de Détection de Ruptures Paradigmatiques]
            C3 --> MERGE
        end
        
        subgraph AnalyseCom["Intelligence d'Analyse Commerciale"]
            D1[Agent IA d'Analyse des Besoins Clients]
            D1 --> D2[Agent IA d'Extraction de Points de Douleur]
            D2 --> D3[Agent IA de Détection d'Intentions d'Achat]
            D3 --> MERGE
        end
        
        subgraph AnalyseTech["Intelligence d'Analyse Technologique"]
            E1[Agent IA d'Analyse Comparative Technique]
            E1 --> E2[Agent IA d'Extraction de Paramètres Performantiels]
            E2 --> E3[Agent IA de Détection d'Interdépendances]
            E3 --> MERGE
        end
        
        subgraph AnalyseJur["Intelligence d'Analyse Juridique"]
            F1[Agent IA d'Analyse d'Implications Réglementaires]
            F1 --> F2[Agent IA d'Extraction d'Obligations Spécifiques]
            F2 --> F3[Agent IA de Détection de Zones Grises]
            F3 --> MERGE
        end
        
        MERGE{Intégration\ndes analyses\nspécialisées}
        
        MERGE --> G1
        
        subgraph Context["Intelligence de Contextualisation"]
            G1[Agent IA d'Enrichissement Contextuel]
            G1 --> G2[Agent IA de Mise en Perspective Historique]
            G2 --> G3[Agent IA d'Analyse Sentiment/Tonalité]
            G3 --> G4[Agent IA de Liaison Interdomaines]
        end
        
        G4 --> OUTPUT[/Information contextualisée et enrichie/]
        OUTPUT --> END([Passage à la phase 3.2])
    end
    
    %% Styles améliorés avec meilleur contraste
    classDef intelligence fill:#8a2be2,stroke:#000,stroke-width:2px,color:#fff
    classDef process fill:#4682b4,stroke:#000,stroke-width:1px,color:#fff
    classDef document fill:#f5a742,stroke:#000,stroke-width:1px,color:#000
    classDef decision fill:#d81b60,stroke:#000,stroke-width:1px,color:#fff
    classDef subgraphStyle fill:#f5f5f5,stroke:#333,stroke-width:1px
    
    %% Application des styles
    class A1,A2,A3,B1,B2,B3,C1,C2,C3,D1,D2,D3,E1,E2,E3,F1,F2,F3,G1,G2,G3,G4 intelligence
    class START,END process
    class INPUT,OUTPUT document
    class BRANCH,MERGE decision
    class AnalyseFonda,AnalyseConc,AnalyseStrat,AnalyseCom,AnalyseTech,AnalyseJur,Context subgraphStyle