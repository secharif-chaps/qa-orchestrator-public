flowchart TD
    subgraph Cartographie["Cartographie des Éléments à Surveiller (Phase 1.2)"]
        START([Document de cadrage de la phase 1.1]) --> INPUT[/Paramètres du type de veille sélectionné/]
        
        subgraph Structuration["Intelligence de Structuration"]
            INPUT --> A1[Agent IA de Taxonomie Adaptative]
            A1 --> A2[Agent IA de Hiérarchisation Multi-critères]
            A2 --> A3[Agent IA de Modélisation Relationnelle]
            A3 --> BRANCH{Spécialisation\npar type\nde veille}
        end
        
        BRANCH -->|Veille Concurrentielle| B1
        BRANCH -->|Veille Stratégique| C1
        BRANCH -->|Veille Commerciale| D1
        BRANCH -->|Veille Technologique| E1
        BRANCH -->|Veille Juridique| F1
        
        subgraph CartoConcurrentielle["Intelligence de Cartographie Concurrentielle"]
            B1[Agent IA de Profiling Concurrentiel]
            B1 --> B2[Agent IA de Mapping d'Écosystème]
            B2 --> B3[Agent IA d'Analyse de Différenciation]
            B3 --> MERGE
        end
        
        subgraph CartoStrategique["Intelligence de Cartographie Stratégique"]
            C1[Agent IA de Détection de Macro-Tendances]
            C1 --> C2[Agent IA de Modélisation d'Influence]
            C2 --> C3[Agent IA d'Identification de Facteurs Disruptifs]
            C3 --> MERGE
        end
        
        subgraph CartoCommerciale["Intelligence de Cartographie Commerciale"]
            D1[Agent IA de Segmentation Avancée]
            D1 --> D2[Agent IA de Mapping Décisionnel Client]
            D2 --> D3[Agent IA de Détection d'Opportunités]
            D3 --> MERGE
        end
        
        subgraph CartoTechnologique["Intelligence de Cartographie Technologique"]
            E1[Agent IA d'Inventaire Technologique]
            E1 --> E2[Agent IA de Mapping d'Innovation]
            E2 --> E3[Agent IA d'Analyse d'Interdépendance Technique]
            E3 --> MERGE
        end
        
        subgraph CartoJuridique["Intelligence de Cartographie Juridique"]
            F1[Agent IA de Corpus Normatif]
            F1 --> F2[Agent IA de Jurisprudence Sectorielle]
            F2 --> F3[Agent IA de Compliance Anticipative]
            F3 --> MERGE
        end
        
        MERGE{Intégration\ndes éléments\nà surveiller}
        
        MERGE --> G1
        
        subgraph Orchestration["Intelligence d'Orchestration"]
            G1[Agent IA de Consolidation Cartographique]
            G1 --> G2[Agent IA de Détection des Angles Morts]
            G2 --> G3[Agent IA d'Optimisation de Couverture]
            G3 --> G4[Agent IA de Visualisation Adaptative]
        end
        
        G4 --> OUTPUT[/Cartographie structurée des éléments à surveiller/]
        OUTPUT --> END([Passage à la phase 1.3])
    end
    
    %% Styles améliorés avec meilleur contraste
    classDef intelligence fill:#8a2be2,stroke:#000,stroke-width:2px,color:#fff
    classDef process fill:#4682b4,stroke:#000,stroke-width:1px,color:#fff
    classDef document fill:#f5a742,stroke:#000,stroke-width:1px,color:#000
    classDef decision fill:#d81b60,stroke:#000,stroke-width:1px,color:#fff
    classDef subgraphStyle fill:#f5f5f5,stroke:#333,stroke-width:1px
    
    %% Application des styles
    class A1,A2,A3,B1,B2,B3,C1,C2,C3,D1,D2,D3,E1,E2,E3,F1,F2,F3,G1,G2,G3,G4 intelligence
    class START,END process
    class INPUT,OUTPUT document
    class BRANCH,MERGE decision
    class Structuration,CartoConcurrentielle,CartoStrategique,CartoCommerciale,CartoTechnologique,CartoJuridique,Orchestration subgraphStyle