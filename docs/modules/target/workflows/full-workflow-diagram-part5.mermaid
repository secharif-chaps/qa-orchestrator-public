flowchart TD
    %% Point de liaison depuis la partie 4
    Part4[Partie 4] -.->|Suite de la partie 4| START5_2
    
    %% PHASE 5.2 - Mesure de Performance et Optimisation
    subgraph Phase5_2["Phase 5.2 - Mesure de Performance et Optimisation"]
        START5_2([Système intégré de la phase 5.1]) --> INPUT5_2[/Système en exploitation/]
        
        subgraph MesureFonda["Intelligence de Mesure Fondamentale"]
            INPUT5_2 --> A1_52[Agent IA de KPIs Système]
            A1_52 --> A2_52[Agent IA d'Analyse de Pertinence]
            A2_52 --> A3_52[Agent IA d'Évaluation Coût-Bénéfice]
            A3_52 --> BRANCH5_2{Spécialisation\npar type\nde veille}
        end
        
        BRANCH5_2 -->|Veille Concurrentielle| B1_52
        BRANCH5_2 -->|Veille Stratégique| C1_52
        BRANCH5_2 -->|Veille Commerciale| D1_52
        BRANCH5_2 -->|Veille Technologique| E1_52
        BRANCH5_2 -->|Veille Juridique| F1_52
        
        subgraph MesureConc["Intelligence de Mesure Concurrentielle"]
            B1_52[Agent IA de Mesure d'Anticipation Concurrentielle]
            B1_52 --> B2_52[Agent IA d'Évaluation d'Impact Décisionnel]
            B2_52 --> B3_52[Agent IA d'Analyse Time-to-Market]
            B3_52 --> MERGE5_2
        end
        
        subgraph MesureStrat["Intelligence de Mesure Stratégique"]
            C1_52[Agent IA de Mesure d'Anticipation des Ruptures]
            C1_52 --> C2_52[Agent IA d'Évaluation d'Impact Investissement]
            C2_52 --> C3_52[Agent IA d'Analyse de Résilience]
            C3_52 --> MERGE5_2
        end
        
        subgraph MesureCom["Intelligence de Mesure Commerciale"]
            D1_52[Agent IA de Mesure de Conversion Opportunités]
            D1_52 --> D2_52[Agent IA d'Évaluation d'Impact sur Cycle de Vente]
            D2_52 --> D3_52[Agent IA d'Analyse de Taux de Gain]
            D3_52 --> MERGE5_2
        end
        
        subgraph MesureTech["Intelligence de Mesure Technologique"]
            E1_52[Agent IA de Mesure d'Avance Technique]
            E1_52 --> E2_52[Agent IA d'Évaluation d'Impact R&D]
            E2_52 --> E3_52[Agent IA d'Analyse d'Obsolescence Évitée]
            E3_52 --> MERGE5_2
        end
        
        subgraph MesureJur["Intelligence de Mesure Juridique"]
            F1_52[Agent IA de Mesure de Conformité]
            F1_52 --> F2_52[Agent IA d'Évaluation de Réduction des Risques]
            F2_52 --> F3_52[Agent IA d'Analyse de Coûts Évités]
            F3_52 --> MERGE5_2
        end
        
        MERGE5_2{Intégration\ndes métriques\nspécifiques}
        
        MERGE5_2 --> G1_52
        
        subgraph OptimSys["Intelligence d'Optimisation Système"]
            G1_52[Agent IA d'Optimisation des Sources]
            G1_52 --> G2_52[Agent IA d'Amélioration des Algorithmes]
            G2_52 --> G3_52[Agent IA de Raffinement des Modèles]
            G3_52 --> G4_52[Agent IA d'Efficience Ressources]
        end
        
        G4_52 --> OUTPUT5_2[/Système optimisé avec métriques de performance/]
    end
    
    %% PHASE 5.3 - Évolution et Gouvernance
    OUTPUT5_2 --> START5_3
    
    subgraph Phase5_3["Phase 5.3 - Évolution et Gouvernance"]
        START5_3([Système optimisé de la phase 5.2]) --> INPUT5_3[/Métriques et données d'optimisation/]
        
        subgraph EvolFonda["Intelligence d'Évolution Fondamentale"]
            INPUT5_3 --> A1_53[Agent IA d'Apprentissage Continu]
            A1_53 --> A2_53[Agent IA de Gouvernance Données]
            A2_53 --> A3_53[Agent IA de Surveillance Qualité]
            A3_53 --> BRANCH5_3{Spécialisation\npar type\nde veille}
        end
        
        BRANCH5_3 -->|Veille Concurrentielle| B1_53
        BRANCH5_3 -->|Veille Stratégique| C1_53
        BRANCH5_3 -->|Veille Commerciale| D1_53
        BRANCH5_3 -->|Veille Technologique| E1_53
        BRANCH5_3 -->|Veille Juridique| F1_53
        
        subgraph EvolConc["Intelligence d'Évolution Concurrentielle"]
            B1_53[Agent IA d'Adaptation aux Stratégies Concurrentielles]
            B1_53 --> B2_53[Agent IA d'Évolution des Modèles Détection]
            B2_53 --> B3_53[Agent IA de Mise à Jour des Taxonomies]
            B3_53 --> MERGE5_3
        end
        
        subgraph EvolStrat["Intelligence d'Évolution Stratégique"]
            C1_53[Agent IA d'Adaptation aux Paradigmes Prospectifs]
            C1_53 --> C2_53[Agent IA d'Élargissement Horizon Temporel]
            C2_53 --> C3_53[Agent IA de Renforcement Capacités Prédictives]
            C3_53 --> MERGE5_3
        end
        
        subgraph EvolCom["Intelligence d'Évolution Commerciale"]
            D1_53[Agent IA d'Adaptation aux Canaux d'Expression Client]
            D1_53 --> D2_53[Agent IA d'Évolution des Modèles de Qualification]
            D2_53 --> D3_53[Agent IA de Mise à Jour des Signaux d'Achat]
            D3_53 --> MERGE5_3
        end
        
        subgraph EvolTech["Intelligence d'Évolution Technologique"]
            E1_53[Agent IA d'Adaptation aux Cycles d'Innovation]
            E1_53 --> E2_53[Agent IA d'Extension Domaines Technologiques]
            E2_53 --> E3_53[Agent IA de Renforcement Détection Disruptive]
            E3_53 --> MERGE5_3
        end
        
        subgraph EvolJur["Intelligence d'Évolution Juridique"]
            F1_53[Agent IA d'Adaptation aux Mécanismes Normatifs]
            F1_53 --> F2_53[Agent IA d'Élargissement Périmètre Géographique]
            F2_53 --> F3_53[Agent IA de Renforcement Analyse d'Impact]
            F3_53 --> MERGE5_3
        end
        
        MERGE5_3{Intégration\ndes évolutions\nspécifiques}
        
        MERGE5_3 --> G1_53
        
        subgraph Gouvernance["Intelligence de Gouvernance Système"]
            G1_53[Agent IA de Pilotage Stratégique]
            G1_53 --> G2_53[Agent IA de Conformité Éthique]
            G2_53 --> G3_53[Agent IA de Gestion des Risques]
            G3_53 --> G4_53[Agent IA d'Adaptation Organisationnelle]
        end
        
        G4_53 --> OUTPUT5_3[/Système évolutif avec gouvernance intégrée/]
        OUTPUT5_3 --> END([Système complet et auto-adaptatif])
    end
    
    %% Point de rétroaction - Cycle d'amélioration continue
    END -.->|Cycle d'amélioration continue| START1_1
    
    %% Styles améliorés avec meilleur contraste
    classDef phaseTitle fill:#2c3e50,stroke:#000,stroke-width:2px,color:#fff,font-weight:bold
    classDef intelligence fill:#8a2be2,stroke:#000,stroke-width:2px,color:#fff
    classDef process fill:#4682b4,stroke:#000,stroke-width:1px,color:#fff
    classDef document fill:#f5a742,stroke:#000,stroke-width:1px,color:#000
    classDef decision fill:#d81b60,stroke:#000,stroke-width:1px,color:#fff
    classDef subgraphStyle fill:#f5f5f5,stroke:#333,stroke-width:1px
    classDef linkNode fill:#80bdab,stroke:#333,stroke-width:1px,color:#000
    classDef endNode fill:#27ae60,stroke:#000,stroke-width:2px,color:#fff
    
    %% Application des styles aux phases
    class Phase5_2,Phase5_3 phaseTitle
    class Part4 linkNode
    class END endNode
    
    %% Application des styles aux éléments
    class A1_52,A2_52,A3_52,B1_52,B2_52,B3_52,C1_52,C2_52,C3_52,D1_52,D2_52,D3_52,E1_52,E2_52,E3_52,F1_52,F2_52,F3_52,G1_52,G2_52,G3_52,G4_52 intelligence
    class A1_53,A2_53,A3_53,B1_53,B2_53,B3_53,C1_53,C2_53,C3_53,D1_53,D2_53,D3_53,E1_53,E2_53,E3_53,F1_53,F2_53,F3_53,G1_53,G2_53,G3_53,G4_53 intelligence
    
    class START5_2,START5_3,START1_1 process
    class INPUT5_2,INPUT5_3,OUTPUT5_2,OUTPUT5_3 document
    class BRANCH5_2,MERGE5_2,BRANCH5_3,MERGE5_3 decision
    
    class MesureFonda,MesureConc,MesureStrat,MesureCom,MesureTech,MesureJur,OptimSys subgraphStyle
    class EvolFonda,EvolConc,EvolStrat,EvolCom,EvolTech,EvolJur,Gouvernance subgraphStyle