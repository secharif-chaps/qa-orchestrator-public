flowchart TD
    subgraph Verification["Vérification et Évaluation (Phase 3.2)"]
        START([Information contextualisée de la phase 3.1]) --> INPUT[/Données enrichies à vérifier/]
        
        subgraph VerifFonda["Intelligence de Vérification Fondamentale"]
            INPUT --> A1[Agent IA de Recoupement Multi-Source]
            A1 --> A2[Agent IA d'Évaluation de Cohérence]
            A2 --> A3[Agent IA d'Attribution de Score de Fiabilité]
            A3 --> BRANCH{Spécialisation\npar type\nde veille}
        end
        
        BRANCH -->|Veille Concurrentielle| B1
        BRANCH -->|Veille Stratégique| C1
        BRANCH -->|Veille Commerciale| D1
        BRANCH -->|Veille Technologique| E1
        BRANCH -->|Veille Juridique| F1
        
        subgraph VerifConc["Intelligence de Vérification Concurrentielle"]
            B1[Agent IA de Vérification d'Allégations Marketing]
            B1 --> B2[Agent IA d'Évaluation de Concordance Produit/Discours]
            B2 --> B3[Agent IA de Détection de Désinformation Concurrentielle]
            B3 --> MERGE
        end
        
        subgraph VerifStrat["Intelligence de Vérification Stratégique"]
            C1[Agent IA de Vérification Méthodologique]
            C1 --> C2[Agent IA d'Évaluation de Crédibilité Prospective]
            C2 --> C3[Agent IA de Détection de Biais Idéologiques]
            C3 --> MERGE
        end
        
        subgraph VerifCom["Intelligence de Vérification Commerciale"]
            D1[Agent IA de Vérification de Maturité Projet]
            D1 --> D2[Agent IA d'Évaluation de Solvabilité Client]
            D2 --> D3[Agent IA de Qualification BANT]
            D3 --> MERGE
        end
        
        subgraph VerifTech["Intelligence de Vérification Technologique"]
            E1[Agent IA de Vérification de Performances Revendiquées]
            E1 --> E2[Agent IA d'Évaluation de Maturité TRL]
            E2 --> E3[Agent IA de Détection de Limitations Non Divulguées]
            E3 --> MERGE
        end
        
        subgraph VerifJur["Intelligence de Vérification Juridique"]
            F1[Agent IA de Vérification d'Autorité des Sources]
            F1 --> F2[Agent IA d'Évaluation d'Applicabilité Spécifique]
            F2 --> F3[Agent IA de Détection de Conflits Réglementaires]
            F3 --> MERGE
        end
        
        MERGE{Intégration\ndes vérifications\nspécifiques}
        
        MERGE --> G1
        
        subgraph Evaluation["Intelligence d'Évaluation Globale"]
            G1[Agent IA de Synthèse Multi-critères]
            G1 --> G2[Agent IA de Détection de Biais Algorithmiques]
            G2 --> G3[Agent IA de Traçabilité des Sources]
            G3 --> G4[Agent IA d'Évaluation d'Incertitude]
        end
        
        G4 --> OUTPUT[/Information vérifiée avec score de fiabilité/]
        OUTPUT --> END([Passage à la phase 3.3])
    end
    
    %% Styles améliorés avec meilleur contraste
    classDef intelligence fill:#8a2be2,stroke:#000,stroke-width:2px,color:#fff
    classDef process fill:#4682b4,stroke:#000,stroke-width:1px,color:#fff
    classDef document fill:#f5a742,stroke:#000,stroke-width:1px,color:#000
    classDef decision fill:#d81b60,stroke:#000,stroke-width:1px,color:#fff
    classDef subgraphStyle fill:#f5f5f5,stroke:#333,stroke-width:1px
    
    %% Application des styles
    class A1,A2,A3,B1,B2,B3,C1,C2,C3,D1,D2,D3,E1,E2,E3,F1,F2,F3,G1,G2,G3,G4 intelligence
    class START,END process
    class INPUT,OUTPUT document
    class BRANCH,MERGE decision
    class VerifFonda,VerifConc,VerifStrat,VerifCom,VerifTech,VerifJur,Evaluation subgraphStyle