flowchart TD
    subgraph Integration["Intégration aux Processus Métier (Phase 5.1)"]
        START([Plateforme collaborative de la phase 4.3]) --> INPUT[/Plateforme fonctionnelle complète/]
        
        subgraph IntegFonda["Intelligence d'Intégration Fondamentale"]
            INPUT --> A1[Agent IA de Connecteurs API]
            A1 --> A2[Agent IA d'Automatisation de Workflow]
            A2 --> A3[Agent IA de Traçabilité Décisionnelle]
            A3 --> BRANCH{Spécialisation\npar type\nde veille}
        end
        
        BRANCH -->|Veille Concurrentielle| B1
        BRANCH -->|Veille Stratégique| C1
        BRANCH -->|Veille Commerciale| D1
        BRANCH -->|Veille Technologique| E1
        BRANCH -->|Veille Juridique| F1
        
        subgraph IntegConc["Intelligence d'Intégration Concurrentielle"]
            B1[Agent IA d'Intégration Produit]
            B1 --> B2[Agent IA de Synchronisation Marketing]
            B2 --> B3[Agent IA d'Alimentation Commerciale]
            B3 --> MERGE
        end
        
        subgraph IntegStrat["Intelligence d'Intégration Stratégique"]
            C1[Agent IA d'Intégration Planning Stratégique]
            C1 --> C2[Agent IA de Synchronisation Portefeuille]
            C2 --> C3[Agent IA d'Alimentation Scénarios]
            C3 --> MERGE
        end
        
        subgraph IntegCom["Intelligence d'Intégration Commerciale"]
            D1[Agent IA d'Intégration CRM]
            D1 --> D2[Agent IA de Synchronisation Lead Generation]
            D2 --> D3[Agent IA d'Alimentation Briefings]
            D3 --> MERGE
        end
        
        subgraph IntegTech["Intelligence d'Intégration Technologique"]
            E1[Agent IA d'Intégration Roadmap Produit]
            E1 --> E2[Agent IA de Synchronisation R&D]
            E2 --> E3[Agent IA d'Alimentation Architecture]
            E3 --> MERGE
        end
        
        subgraph IntegJur["Intelligence d'Intégration Juridique"]
            F1[Agent IA d'Intégration Compliance]
            F1 --> F2[Agent IA de Synchronisation Audits]
            F2 --> F3[Agent IA d'Alimentation Formation]
            F3 --> MERGE
        end
        
        MERGE{Intégration\ndes connexions\nmétier}
        
        MERGE --> G1
        
        subgraph Pilotage["Intelligence de Pilotage Métier"]
            G1[Agent IA de Monitoring d'Adoption]
            G1 --> G2[Agent IA de Mesure d'Impact Décisionnel]
            G2 --> G3[Agent IA d'Optimisation de Flux]
            G3 --> G4[Agent IA d'Alignement Stratégique]
        end
        
        G4 --> OUTPUT[/Système intégré aux processus métier/]
        OUTPUT --> END([Passage à la phase 5.2])
    end
    
    %% Styles améliorés avec meilleur contraste
    classDef intelligence fill:#8a2be2,stroke:#000,stroke-width:2px,color:#fff
    classDef process fill:#4682b4,stroke:#000,stroke-width:1px,color:#fff
    classDef document fill:#f5a742,stroke:#000,stroke-width:1px,color:#000
    classDef decision fill:#d81b60,stroke:#000,stroke-width:1px,color:#fff
    classDef subgraphStyle fill:#f5f5f5,stroke:#333,stroke-width:1px
    
    %% Application des styles
    class A1,A2,A3,B1,B2,B3,C1,C2,C3,D1,D2,D3,E1,E2,E3,F1,F2,F3,G1,G2,G3,G4 intelligence
    class START,END process
    class INPUT,OUTPUT document
    class BRANCH,MERGE decision
    class IntegFonda,IntegConc,IntegStrat,IntegCom,IntegTech,IntegJur,Pilotage subgraphStyle