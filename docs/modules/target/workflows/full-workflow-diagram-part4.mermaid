flowchart TD
    %% Point de liaison depuis la partie 3
    Part3[Partie 3] -.->|Suite de la partie 3| START4_2
    
    %% PHASE 4.2 - Système d'Alertes Intelligentes
    subgraph Phase4_2["Phase 4.2 - Système d'Alertes Intelligentes"]
        START4_2([Contenu de la phase 4.1]) --> INPUT4_2[/Contenu à forte valeur ajoutée/]
        
        subgraph Notification["Intelligence de Notification Fondamentale"]
            INPUT4_2 --> A1_42[Agent IA de Priorisation des Informations]
            A1_42 --> A2_42[Agent IA de Contextualisation d'Alerte]
            A2_42 --> A3_42[Agent IA de Timing Optimal]
            A3_42 --> BRANCH4_2{Spécialisation\npar type\nde veille}
        end
        
        BRANCH4_2 -->|Veille Concurrentielle| B1_42
        BRANCH4_2 -->|Veille Stratégique| C1_42
        BRANCH4_2 -->|Veille Commerciale| D1_42
        BRANCH4_2 -->|Veille Technologique| E1_42
        BRANCH4_2 -->|Veille Juridique| F1_42
        
        subgraph AlertesConc["Intelligence d'Alertes Concurrentielles"]
            B1_42[Agent IA d'Alertes Mouvements Stratégiques]
            B1_42 --> B2_42[Agent IA de Notifications Prix et Produits]
            B2_42 --> B3_42[Agent IA d'Alertes Communications]
            B3_42 --> MERGE4_2
        end
        
        subgraph AlertesStrat["Intelligence d'Alertes Stratégiques"]
            C1_42[Agent IA d'Alertes Ruptures Tendancielles]
            C1_42 --> C2_42[Agent IA de Notifications Géopolitiques]
            C2_42 --> C3_42[Agent IA d'Alertes Transformations Structurelles]
            C3_42 --> MERGE4_2
        end
        
        subgraph AlertesCom["Intelligence d'Alertes Commerciales"]
            D1_42[Agent IA d'Alertes Opportunités Business]
            D1_42 --> D2_42[Agent IA de Notifications Appels d'Offres]
            D2_42 --> D3_42[Agent IA d'Alertes Déclencheurs d'Achat]
            D3_42 --> MERGE4_2
        end
        
        subgraph AlertesTech["Intelligence d'Alertes Technologiques"]
            E1_42[Agent IA d'Alertes Innovations Critiques]
            E1_42 --> E2_42[Agent IA de Notifications Standards]
            E2_42 --> E3_42[Agent IA d'Alertes Obsolescence]
            E3_42 --> MERGE4_2
        end
        
        subgraph AlertesJur["Intelligence d'Alertes Juridiques"]
            F1_42[Agent IA d'Alertes Réglementaires]
            F1_42 --> F2_42[Agent IA de Notifications Jurisprudentielles]
            F2_42 --> F3_42[Agent IA d'Alertes Échéances Conformité]
            F3_42 --> MERGE4_2
        end
        
        MERGE4_2{Intégration\ndes alertes\nspécialisées}
        
        MERGE4_2 --> G1_42
        
        subgraph Diffusion["Intelligence de Diffusion Personnalisée"]
            G1_42[Agent IA de Personnalisation Utilisateur]
            G1_42 --> G2_42[Agent IA de Multicanal Adaptatif]
            G2_42 --> G3_42[Agent IA de Feedback Instantané]
            G3_42 --> G4_42[Agent IA d'Apprentissage de Préférences]
        end
        
        G4_42 --> OUTPUT4_2[/Alertes personnalisées et contextualisées/]
    end
    
    %% PHASE 4.3 - Interface Collaborative
    OUTPUT4_2 --> START4_3
    
    subgraph Phase4_3["Phase 4.3 - Interface Collaborative"]
        START4_3([Alertes de la phase 4.2]) --> INPUT4_3[/Alertes personnalisées et contenus/]
        
        subgraph CollabFonda["Intelligence de Collaboration Fondamentale"]
            INPUT4_3 --> A1_43[Agent IA d'Accès Unifié]
            A1_43 --> A2_43[Agent IA de Recherche Sémantique]
            A2_43 --> A3_43[Agent IA d'Interface Conversationnelle]
            A3_43 --> BRANCH4_3{Spécialisation\npar type\nde veille}
        end
        
        BRANCH4_3 -->|Veille Concurrentielle| B1_43
        BRANCH4_3 -->|Veille Stratégique| C1_43
        BRANCH4_3 -->|Veille Commerciale| D1_43
        BRANCH4_3 -->|Veille Technologique| E1_43
        BRANCH4_3 -->|Veille Juridique| F1_43
        
        subgraph CollabConc["Intelligence de Collaboration Concurrentielle"]
            B1_43[Agent IA d'Espaces Produit/Marketing]
            B1_43 --> B2_43[Agent IA de Comparaison Interactive]
            B2_43 --> B3_43[Agent IA d'Annotation Stratégique]
            B3_43 --> MERGE4_3
        end
        
        subgraph CollabStrat["Intelligence de Collaboration Stratégique"]
            C1_43[Agent IA d'Espaces Scénarios Collaboratifs]
            C1_43 --> C2_43[Agent IA de Modélisation d'Impact]
            C2_43 --> C3_43[Agent IA de Forums Prospectifs]
            C3_43 --> MERGE4_3
        end
        
        subgraph CollabCom["Intelligence de Collaboration Commerciale"]
            D1_43[Agent IA d'Intégration CRM]
            D1_43 --> D2_43[Agent IA de Qualification Collaborative]
            D2_43 --> D3_43[Agent IA de Partage d'Insights Client]
            D3_43 --> MERGE4_3
        end
        
        subgraph CollabTech["Intelligence de Collaboration Technologique"]
            E1_43[Agent IA d'Espaces R&D Collaboratifs]
            E1_43 --> E2_43[Agent IA d'Évaluation Comparative]
            E2_43 --> E3_43[Agent IA d'Annotation Technique]
            E3_43 --> MERGE4_3
        end
        
        subgraph CollabJur["Intelligence de Collaboration Juridique"]
            F1_43[Agent IA d'Intégration Compliance]
            F1_43 --> F2_43[Agent IA d'Évaluation Risques Collaborative]
            F2_43 --> F3_43[Agent IA de Suivi d'Actions]
            F3_43 --> MERGE4_3
        end
        
        MERGE4_3{Intégration\ndes modules\ncollaboratifs}
        
        MERGE4_3 --> G1_43
        
        subgraph Visualisation["Intelligence de Visualisation Interactive"]
            G1_43[Agent IA de Tableaux de Bord Dynamiques]
            G1_43 --> G2_43[Agent IA de Représentation Graphique]
            G2_43 --> G3_43[Agent IA d'Adaptation de Vue]
            G3_43 --> G4_43[Agent IA d'Intelligence Collective]
        end
        
        G4_43 --> OUTPUT4_3[/Plateforme collaborative interactive/]
    end
    
    %% PHASE 5.1 - Intégration aux Processus Métier
    OUTPUT4_3 --> START5_1
    
    subgraph Phase5_1["Phase 5.1 - Intégration aux Processus Métier"]
        START5_1([Plateforme collaborative de la phase 4.3]) --> INPUT5_1[/Plateforme fonctionnelle complète/]
        
        subgraph IntegFonda["Intelligence d'Intégration Fondamentale"]
            INPUT5_1 --> A1_51[Agent IA de Connecteurs API]
            A1_51 --> A2_51[Agent IA d'Automatisation de Workflow]
            A2_51 --> A3_51[Agent IA de Traçabilité Décisionnelle]
            A3_51 --> BRANCH5_1{Spécialisation\npar type\nde veille}
        end
        
        BRANCH5_1 -->|Veille Concurrentielle| B1_51
        BRANCH5_1 -->|Veille Stratégique| C1_51
        BRANCH5_1 -->|Veille Commerciale| D1_51
        BRANCH5_1 -->|Veille Technologique| E1_51
        BRANCH5_1 -->|Veille Juridique| F1_51
        
        subgraph IntegConc["Intelligence d'Intégration Concurrentielle"]
            B1_51[Agent IA d'Intégration Produit]
            B1_51 --> B2_51[Agent IA de Synchronisation Marketing]
            B2_51 --> B3_51[Agent IA d'Alimentation Commerciale]
            B3_51 --> MERGE5_1
        end
        
        subgraph IntegStrat["Intelligence d'Intégration Stratégique"]
            C1_51[Agent IA d'Intégration Planning Stratégique]
            C1_51 --> C2_51[Agent IA de Synchronisation Portefeuille]
            C2_51 --> C3_51[Agent IA d'Alimentation Scénarios]
            C3_51 --> MERGE5_1
        end
        
        subgraph IntegCom["Intelligence d'Intégration Commerciale"]
            D1_51[Agent IA d'Intégration CRM]
            D1_51 --> D2_51[Agent IA de Synchronisation Lead Generation]
            D2_51 --> D3_51[Agent IA d'Alimentation Briefings]
            D3_51 --> MERGE5_1
        end
        
        subgraph IntegTech["Intelligence d'Intégration Technologique"]
            E1_51[Agent IA d'Intégration Roadmap Produit]
            E1_51 --> E2_51[Agent IA de Synchronisation R&D]
            E2_51 --> E3_51[Agent IA d'Alimentation Architecture]
            E3_51 --> MERGE5_1
        end
        
        subgraph IntegJur["Intelligence d'Intégration Juridique"]
            F1_51[Agent IA d'Intégration Compliance]
            F1_51 --> F2_51[Agent IA de Synchronisation Audits]
            F2_51 --> F3_51[Agent IA d'Alimentation Formation]
            F3_51 --> MERGE5_1
        end
        
        MERGE5_1{Intégration\ndes connexions\nmétier}
        
        MERGE5_1 --> G1_51
        
        subgraph Pilotage["Intelligence de Pilotage Métier"]
            G1_51[Agent IA de Monitoring d'Adoption]
            G1_51 --> G2_51[Agent IA de Mesure d'Impact Décisionnel]
            G2_51 --> G3_51[Agent IA d'Optimisation de Flux]
            G3_51 --> G4_51[Agent IA d'Alignement Stratégique]
        end
        
        G4_51 --> OUTPUT5_1[/Système intégré aux processus métier/]
    end
    
    %% Liaison vers la partie 5
    OUTPUT5_1 -.->|Suite dans Partie 5| Part5
    
    %% Styles améliorés avec meilleur contraste
    classDef phaseTitle fill:#2c3e50,stroke:#000,stroke-width:2px,color:#fff,font-weight:bold
    classDef intelligence fill:#8a2be2,stroke:#000,stroke-width:2px,color:#fff
    classDef process fill:#4682b4,stroke:#000,stroke-width:1px,color:#fff
    classDef document fill:#f5a742,stroke:#000,stroke-width:1px,color:#000
    classDef decision fill:#d81b60,stroke:#000,stroke-width:1px,color:#fff
    classDef subgraphStyle fill:#f5f5f5,stroke:#333,stroke-width:1px
    classDef linkNode fill:#80bdab,stroke:#333,stroke-width:1px,color:#000
    
    %% Application des styles aux phases
    class Phase4_2,Phase4_3,Phase5_1 phaseTitle
    class Part3,Part5 linkNode
    
    %% Application des styles aux éléments
    class A1_42,A2_42,A3_42,B1_42,B2_42,B3_42,C1_42,C2_42,C3_42,D1_42,D2_42,D3_42,E1_42,E2_42,E3_42,F1_42,F2