flowchart TD
    subgraph Configuration["Configuration des Critères et Alertes (Phase 1.3)"]
        START([Cartographie structurée de la phase 1.2]) --> INPUT[/Éléments à surveiller et paramètres/]
        
        subgraph Parametrage["Intelligence de Paramétrage Commun"]
            INPUT --> A1[Agent IA de Définition des KPIs]
            A1 --> A2[Agent IA de Traduction Langage Naturel]
            A2 --> A3[Agent IA de Scoring Multi-dimensionnel]
            A3 --> BRANCH{Personnalisation\npar type\nde veille}
        end
        
        BRANCH -->|Veille Concurrentielle| B1
        BRANCH -->|Veille Stratégique| C1
        BRANCH -->|Veille Commerciale| D1
        BRANCH -->|Veille Technologique| E1
        BRANCH -->|Veille Juridique| F1
        
        subgraph CriteresConc["Intelligence de Critères Concurrentiels"]
            B1[Agent IA de Monitoring Produit/Service]
            B1 --> B2[Agent IA de Surveillance Tarifaire]
            B2 --> B3[Agent IA de Détection Marketing]
            B3 --> MERGE
        end
        
        subgraph CriteresStrat["Intelligence de Critères Stratégiques"]
            C1[Agent IA de Détection de Ruptures]
            C1 --> C2[Agent IA de Surveillance Macro-environnementale]
            C2 --> C3[Agent IA d'Analyse de Points d'Inflexion]
            C3 --> MERGE
        end
        
        subgraph CriteresCom["Intelligence de Critères Commerciaux"]
            D1[Agent IA de Détection de Triggers d'Achat]
            D1 --> D2[Agent IA de Qualification d'Appels d'Offres]
            D2 --> D3[Agent IA de Monitoring Comportemental]
            D3 --> MERGE
        end
        
        subgraph CriteresTech["Intelligence de Critères Technologiques"]
            E1[Agent IA de Surveillance d'Avancées Techniques]
            E1 --> E2[Agent IA de Détection de Brevets Stratégiques]
            E2 --> E3[Agent IA de Monitoring d'Adoption]
            E3 --> MERGE
        end
        
        subgraph CriteresJur["Intelligence de Critères Juridiques"]
            F1[Agent IA de Veille Normative]
            F1 --> F2[Agent IA de Détection Jurisprudentielle]
            F2 --> F3[Agent IA de Calendrier Réglementaire]
            F3 --> MERGE
        end
        
        MERGE{Intégration\ndes critères\nspécifiques}
        
        MERGE --> G1
        
        subgraph Alertes["Intelligence d'Alertes et Notifications"]
            G1[Agent IA de Configuration des Seuils]
            G1 --> G2[Agent IA de Personnalisation par Utilisateur]
            G2 --> G3[Agent IA de Priorisation Contextuelle]
            G3 --> G4[Agent IA de Tests et Simulation]
        end
        
        G4 --> OUTPUT[/Configuration complète des critères et alertes/]
        OUTPUT --> END([Passage à la phase 2])
    end
    
    %% Styles améliorés avec meilleur contraste
    classDef intelligence fill:#8a2be2,stroke:#000,stroke-width:2px,color:#fff
    classDef process fill:#4682b4,stroke:#000,stroke-width:1px,color:#fff
    classDef document fill:#f5a742,stroke:#000,stroke-width:1px,color:#000
    classDef decision fill:#d81b60,stroke:#000,stroke-width:1px,color:#fff
    classDef subgraphStyle fill:#f5f5f5,stroke:#333,stroke-width:1px
    
    %% Application des styles
    class A1,A2,A3,B1,B2,B3,C1,C2,C3,D1,D2,D3,E1,E2,E3,F1,F2,F3,G1,G2,G3,G4 intelligence
    class START,END process
    class INPUT,OUTPUT document
    class BRANCH,MERGE decision
    class Parametrage,CriteresConc,CriteresStrat,CriteresCom,CriteresTech,CriteresJur,Alertes subgraphStyle