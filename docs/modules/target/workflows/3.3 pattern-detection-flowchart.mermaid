flowchart TD
    subgraph Detection["Détection des Patterns et Signaux (Phase 3.3)"]
        START([Information vérifiée de la phase 3.2]) --> INPUT[/Données fiabilisées avec scores/]
        
        subgraph AnaTemp["Intelligence d'Analyse Temporelle"]
            INPUT --> A1[Agent IA d'Analyse de Tendances]
            A1 --> A2[Agent IA de Détection d'Anomalies]
            A2 --> A3[Agent IA d'Identification de Signaux Faibles]
            A3 --> BRANCH{Spécialisation\npar type\nde veille}
        end
        
        BRANCH -->|Veille Concurrentielle| B1
        BRANCH -->|Veille Stratégique| C1
        BRANCH -->|Veille Commerciale| D1
        BRANCH -->|Veille Technologique| E1
        BRANCH -->|Veille Juridique| F1
        
        subgraph PatternConc["Intelligence de Patterns Concurrentiels"]
            B1[Agent IA de Détection de Pivots Stratégiques]
            B1 --> B2[Agent IA d'Identification de Cycles d'Innovation]
            B2 --> B3[Agent IA de Repérage de Mouvements Capitalistiques]
            B3 --> MERGE
        end
        
        subgraph PatternStrat["Intelligence de Patterns Stratégiques"]
            C1[Agent IA de Détection de Ruptures de Tendances]
            C1 --> C2[Agent IA d'Identification de Convergences Sectorielles]
            C2 --> C3[Agent IA de Repérage de Transformations Structurelles]
            C3 --> MERGE
        end
        
        subgraph PatternCom["Intelligence de Patterns Commerciaux"]
            D1[Agent IA de Détection de Signaux d'Achat Imminents]
            D1 --> D2[Agent IA d'Identification d'Opportunités Cross-Selling]
            D2 --> D3[Agent IA de Repérage de Cycles Budgétaires]
            D3 --> MERGE
        end
        
        subgraph PatternTech["Intelligence de Patterns Technologiques"]
            E1[Agent IA de Détection de Technologies Émergentes]
            E1 --> E2[Agent IA d'Identification de Courbes d'Adoption]
            E2 --> E3[Agent IA de Repérage de Convergences Technologiques]
            E3 --> MERGE
        end
        
        subgraph PatternJur["Intelligence de Patterns Juridiques"]
            F1[Agent IA de Détection de Tendances Réglementaires]
            F1 --> F2[Agent IA d'Identification de Risques de Non-Conformité]
            F2 --> F3[Agent IA de Repérage d'Évolutions Normatives]
            F3 --> MERGE
        end
        
        MERGE{Intégration\ndes patterns\nidentifiés}
        
        MERGE --> G1
        
        subgraph Predictive["Intelligence Prédictive"]
            G1[Agent IA de Corrélation Multi-facteurs]
            G1 --> G2[Agent IA de Modélisation Prédictive]
            G2 --> G3[Agent IA d'Analyse d'Impact Croisé]
            G3 --> G4[Agent IA de Génération de Scénarios]
        end
        
        G4 --> OUTPUT[/Insights avec patterns et prédictions/]
        OUTPUT --> END([Passage à la phase 4.1])
    end
    
    %% Styles améliorés avec meilleur contraste
    classDef intelligence fill:#8a2be2,stroke:#000,stroke-width:2px,color:#fff
    classDef process fill:#4682b4,stroke:#000,stroke-width:1px,color:#fff
    classDef document fill:#f5a742,stroke:#000,stroke-width:1px,color:#000
    classDef decision fill:#d81b60,stroke:#000,stroke-width:1px,color:#fff
    classDef subgraphStyle fill:#f5f5f5,stroke:#333,stroke-width:1px
    
    %% Application des styles
    class A1,A2,A3,B1,B2,B3,C1,C2,C3,D1,D2,D3,E1,E2,E3,F1,F2,F3,G1,G2,G3,G4 intelligence
    class START,END process
    class INPUT,OUTPUT document
    class BRANCH,MERGE decision
    class AnaTemp,PatternConc,PatternStrat,PatternCom,PatternTech,PatternJur,Predictive subgraphStyle