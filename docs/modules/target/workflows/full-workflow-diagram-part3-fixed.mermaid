flowchart TD
    %% Point de liaison depuis la partie 2
    Part2[Partie 2] -.->|Suite de la partie 2| START3_2
    
    %% PHASE 3.2 - Vérification et Évaluation
    subgraph Phase3_2["Phase 3.2 - Vérification et Évaluation"]
        START3_2([Information contextualisée de la phase 3.1]) --> INPUT3_2[/Données enrichies à vérifier/]
        
        subgraph VerifFonda["Intelligence de Vérification Fondamentale"]
            INPUT3_2 --> A1_32[Agent IA de Recoupement Multi-Source]
            A1_32 --> A2_32[Agent IA d'Évaluation de Cohérence]
            A2_32 --> A3_32[Agent IA d'Attribution de Score de Fiabilité]
            A3_32 --> BRANCH3_2{Spécialisation\npar type\nde veille}
        end
        
        BRANCH3_2 -->|Veille Concurrentielle| B1_32
        BRANCH3_2 -->|Veille Stratégique| C1_32
        BRANCH3_2 -->|Veille Commerciale| D1_32
        BRANCH3_2 -->|Veille Technologique| E1_32
        BRANCH3_2 -->|Veille Juridique| F1_32
        
        subgraph VerifConc["Intelligence de Vérification Concurrentielle"]
            B1_32[Agent IA de Vérification d'Allégations Marketing]
            B1_32 --> B2_32[Agent IA d'Évaluation de Concordance Produit/Discours]
            B2_32 --> B3_32[Agent IA de Détection de Désinformation Concurrentielle]
            B3_32 --> MERGE3_2
        end
        
        subgraph VerifStrat["Intelligence de Vérification Stratégique"]
            C1_32[Agent IA de Vérification Méthodologique]
            C1_32 --> C2_32[Agent IA d'Évaluation de Crédibilité Prospective]
            C2_32 --> C3_32[Agent IA de Détection de Biais Idéologiques]
            C3_32 --> MERGE3_2
        end
        
        subgraph VerifCom["Intelligence de Vérification Commerciale"]
            D1_32[Agent IA de Vérification de Maturité Projet]
            D1_32 --> D2_32[Agent IA d'Évaluation de Solvabilité Client]
            D2_32 --> D3_32[Agent IA de Qualification BANT]
            D3_32 --> MERGE3_2
        end
        
        subgraph VerifTech["Intelligence de Vérification Technologique"]
            E1_32[Agent IA de Vérification de Performances Revendiquées]
            E1_32 --> E2_32[Agent IA d'Évaluation de Maturité TRL]
            E2_32 --> E3_32[Agent IA de Détection de Limitations Non Divulguées]
            E3_32 --> MERGE3_2
        end
        
        subgraph VerifJur["Intelligence de Vérification Juridique"]
            F1_32[Agent IA de Vérification d'Autorité des Sources]
            F1_32 --> F2_32[Agent IA d'Évaluation d'Applicabilité Spécifique]
            F2_32 --> F3_32[Agent IA de Détection de Conflits Réglementaires]
            F3_32 --> MERGE3_2
        end
        
        MERGE3_2{Intégration\ndes vérifications\nspécifiques}
        
        MERGE3_2 --> G1_32
        
        subgraph Evaluation["Intelligence d'Évaluation Globale"]
            G1_32[Agent IA de Synthèse Multi-critères]
            G1_32 --> G2_32[Agent IA de Détection de Biais Algorithmiques]
            G2_32 --> G3_32[Agent IA de Traçabilité des Sources]
            G3_32 --> G4_32[Agent IA d'Évaluation d'Incertitude]
        end
        
        G4_32 --> OUTPUT3_2[/Information vérifiée avec score de fiabilité/]
    end
    
    %% PHASE 3.3 - Détection des Patterns et Signaux
    OUTPUT3_2 --> START3_3
    
    subgraph Phase3_3["Phase 3.3 - Détection des Patterns et Signaux"]
        START3_3([Information vérifiée de la phase 3.2]) --> INPUT3_3[/Données fiabilisées avec scores/]
        
        subgraph AnaTemp["Intelligence d'Analyse Temporelle"]
            INPUT3_3 --> A1_33[Agent IA d'Analyse de Tendances]
            A1_33 --> A2_33[Agent IA de Détection d'Anomalies]
            A2_33 --> A3_33[Agent IA d'Identification de Signaux Faibles]
            A3_33 --> BRANCH3_3{Spécialisation\npar type\nde veille}
        end
        
        BRANCH3_3 -->|Veille Concurrentielle| B1_33
        BRANCH3_3 -->|Veille Stratégique| C1_33
        BRANCH3_3 -->|Veille Commerciale| D1_33
        BRANCH3_3 -->|Veille Technologique| E1_33
        BRANCH3_3 -->|Veille Juridique| F1_33
        
        subgraph PatternConc["Intelligence de Patterns Concurrentiels"]
            B1_33[Agent IA de Détection de Pivots Stratégiques]
            B1_33 --> B2_33[Agent IA d'Identification de Cycles d'Innovation]
            B2_33 --> B3_33[Agent IA de Repérage de Mouvements Capitalistiques]
            B3_33 --> MERGE3_3
        end
        
        subgraph PatternStrat["Intelligence de Patterns Stratégiques"]
            C1_33[Agent IA de Détection de Ruptures de Tendances]
            C1_33 --> C2_33[Agent IA d'Identification de Convergences Sectorielles]
            C2_33 --> C3_33[Agent IA de Repérage de Transformations Structurelles]
            C3_33 --> MERGE3_3
        end
        
        subgraph PatternCom["Intelligence de Patterns Commerciaux"]
            D1_33[Agent IA de Détection de Signaux d'Achat Imminents]
            D1_33 --> D2_33[Agent IA d'Identification d'Opportunités Cross-Selling]
            D2_33 --> D3_33[Agent IA de Repérage de Cycles Budgétaires]
            D3_33 --> MERGE3_3
        end
        
        subgraph PatternTech["Intelligence de Patterns Technologiques"]
            E1_33[Agent IA de Détection de Technologies Émergentes]
            E1_33 --> E2_33[Agent IA d'Identification de Courbes d'Adoption]
            E2_33 --> E3_33[Agent IA de Repérage de Convergences Technologiques]
            E3_33 --> MERGE3_3
        end
        
        subgraph PatternJur["Intelligence de Patterns Juridiques"]
            F1_33[Agent IA de Détection de Tendances Réglementaires]
            F1_33 --> F2_33[Agent IA d'Identification de Risques de Non-Conformité]
            F2_33 --> F3_33[Agent IA de Repérage d'Évolutions Normatives]
            F3_33 --> MERGE3_3
        end
        
        MERGE3_3{Intégration\ndes patterns\nidentifiés}
        
        MERGE3_3 --> G1_33
        
        subgraph Predictive["Intelligence Prédictive"]
            G1_33[Agent IA de Corrélation Multi-facteurs]
            G1_33 --> G2_33[Agent IA de Modélisation Prédictive]
            G2_33 --> G3_33[Agent IA d'Analyse d'Impact Croisé]
            G3_33 --> G4_33[Agent IA de Génération de Scénarios]
        end
        
        G4_33 --> OUTPUT3_3[/Insights avec patterns et prédictions/]
    end
    
    %% PHASE 4.1 - Génération de Contenu Adapté
    OUTPUT3_3 --> START4_1
    
    subgraph Phase4_1["Phase 4.1 - Génération de Contenu Adapté"]
        START4_1([Insights de la phase 3.3]) --> INPUT4_1[/Insights avec patterns et prédictions/]
        
        subgraph Transformation["Intelligence de Transformation de Contenu"]
            INPUT4_1 --> A1_41[Agent IA de Synthèse Automatique]
            A1_41 --> A2_41[Agent IA de Structuration de Contenu]
            A2_41 --> A3_41[Agent IA d'Adaptation aux Formats]
            A3_41 --> BRANCH4_1{Spécialisation\npar type\nde veille}
        end
        
        BRANCH4_1 -->|Veille Concurrentielle| B1_41
        BRANCH4_1 -->|Veille Stratégique| C1_41
        BRANCH4_1 -->|Veille Commerciale| D1_41
        BRANCH4_1 -->|Veille Technologique| E1_41
        BRANCH4_1 -->|Veille Juridique| F1_41
        
        subgraph ContentConc["Intelligence de Contenu Concurrentiel"]
            B1_41[Agent IA de Génération de Fiches Concurrentielles]
            B1_41 --> B2_41[Agent IA de Création de Benchmarks]
            B2_41 --> B3_41[Agent IA de Cartographie Dynamique]
            B3_41 --> MERGE4_1
        end
        
        subgraph ContentStrat["Intelligence de Contenu Stratégique"]
            C1_41[Agent IA de Génération de Rapports de Tendances]
            C1_41 --> C2_41[Agent IA de Création de Scénarios Prospectifs]
            C2_41 --> C3_41[Agent IA de Cartographie d'Impact Stratégique]
            C3_41 --> MERGE4_1
        end
        
        subgraph ContentCom["Intelligence de Contenu Commercial"]
            D1_41[Agent IA de Génération de Fiches Prospect]
            D1_41 --> D2_41[Agent IA de Création de Battle Cards]
            D2_41 --> D3_41[Agent IA de Scripts d'Objection]
            D3_41 --> MERGE4_1
        end
        
        subgraph ContentTech["Intelligence de Contenu Technologique"]
            E1_41[Agent IA de Génération de Radar Technologique]
            E1_41 --> E2_41[Agent IA de Création de Fiches Techniques]
            E2_41 --> E3_41[Agent IA de Roadmaps Comparatives]
            E3_41 --> MERGE4_1
        end
        
        subgraph ContentJur["Intelligence de Contenu Juridique"]
            F1_41[Agent IA de Génération de Bulletins Réglementaires]
            F1_41 --> F2_41[Agent IA de Création de Guides de Conformité]
            F2_41 --> F3_41[Agent IA de Calendriers d'Application]
            F3_41 --> MERGE4_1
        end
        
        MERGE4_1{Intégration\ndes contenus\nspécialisés}
        
        MERGE4_1 --> G1_41
        
        subgraph Perso["Intelligence de Personnalisation"]
            G1_41[Agent IA d'Adaptation au Profil Utilisateur]
            G1_41 --> G2_41[Agent IA de Génération Visuelle]
            G2_41 --> G3_41[Agent IA de Narration Explicative]
            G3_41 --> G4_41[Agent IA d'Interactivité Contextuelle]
        end
        
        G4_41 --> OUTPUT4_1[/Contenu à forte valeur ajoutée personnalisé/]
    end

    %% Liaison vers la partie 4
    OUTPUT4_1 -.->|Suite dans Partie 4| Part4
    
    %% Styles améliorés avec meilleur contraste
    classDef phaseTitle fill:#2c3e50,stroke:#000,stroke-width:2px,color:#fff,font-weight:bold
    classDef intelligence fill:#8a2be2,stroke:#000,stroke-width:2px,color:#fff
    classDef process fill:#4682b4,stroke:#000,stroke-width:1px,color:#fff
    classDef document fill:#f5a742,stroke:#000,stroke-width:1px,color:#000
    classDef decision fill:#d81b60,stroke:#000,stroke-width:1px,color:#fff
    classDef subgraphStyle fill:#f5f5f5,stroke:#333,stroke-width:1px
    classDef linkNode fill:#80bdab,stroke:#333,stroke-width:1px,color:#000
    
    %% Application des styles aux phases
    class Phase3_2,Phase3_3,Phase4_1 phaseTitle
    class Part2,Part4 linkNode
    
    %% Application des styles aux éléments
    class A1_32,A2_32,A3_32,B1_32,B2_32,B3_32,C1_32,C2_32,C3_32,D1_32,D2_32,D3_32,E1_32,E2_32,E3_32,F1_32,F2_32,F3_32,G1_32,G2_32,G3_32,G4_32 intelligence
    class A1_33,A2_33,A3_33,B1_33,B2_33,B3_33,C1_33,C2_33,C3_33,D1_33,D2_33,D3_33,E1_33,E2_33,E3_33,F1_33,F2_33,F3_33,G1_33,G2_33,G3_33,G4_33 intelligence
    class A1_41,A2_41,A3_41,B1_41,B2_41,B3_41,C1_41,C2_41,C3_41,D1_41,D2_41,D3_41,E1_41,E2_41,E3_41,F1_41,F2_41,F3_41,G1_41,G2_41,G3_41,G4_41 intelligence
    
    class START3_2,START3_3,START4_1 process
    class INPUT3_2,INPUT3_3,INPUT4_1,OUTPUT3_2,OUTPUT3_3,OUTPUT4_1 document
    class BRANCH3_2,MERGE3_2,BRANCH3_3,MERGE3_3,BRANCH4_1,MERGE4_1 decision
    
    class VerifFonda,VerifConc,VerifStrat,VerifCom,VerifTech,VerifJur,Evaluation subgraphStyle
    class AnaTemp,PatternConc,PatternStrat,PatternCom,PatternTech,PatternJur,Predictive subgraphStyle
    class Transformation,ContentConc,ContentStrat,ContentCom,ContentTech,ContentJur,Perso subgraphStyle