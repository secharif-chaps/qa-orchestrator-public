flowchart TD
    subgraph Evolution["Évolution et Gouvernance (Phase 5.3)"]
        START([Système optimisé de la phase 5.2]) --> INPUT[/Métriques et données d'optimisation/]
        
        subgraph EvolFonda["Intelligence d'Évolution Fondamentale"]
            INPUT --> A1[Agent IA d'Apprentissage Continu]
            A1 --> A2[Agent IA de Gouvernance Données]
            A2 --> A3[Agent IA de Surveillance Qualité]
            A3 --> BRANCH{Spécialisation\npar type\nde veille}
        end
        
        BRANCH -->|Veille Concurrentielle| B1
        BRANCH -->|Veille Stratégique| C1
        BRANCH -->|Veille Commerciale| D1
        BRANCH -->|Veille Technologique| E1
        BRANCH -->|Veille Juridique| F1
        
        subgraph EvolConc["Intelligence d'Évolution Concurrentielle"]
            B1[Agent IA d'Adaptation aux Stratégies Concurrentielles]
            B1 --> B2[Agent IA d'Évolution des Modèles Détection]
            B2 --> B3[Agent IA de Mise à Jour des Taxonomies]
            B3 --> MERGE
        end
        
        subgraph EvolStrat["Intelligence d'Évolution Stratégique"]
            C1[Agent IA d'Adaptation aux Paradigmes Prospectifs]
            C1 --> C2[Agent IA d'Élargissement Horizon Temporel]
            C2 --> C3[Agent IA de Renforcement Capacités Prédictives]
            C3 --> MERGE
        end
        
        subgraph EvolCom["Intelligence d'Évolution Commerciale"]
            D1[Agent IA d'Adaptation aux Canaux d'Expression Client]
            D1 --> D2[Agent IA d'Évolution des Modèles de Qualification]
            D2 --> D3[Agent IA de Mise à Jour des Signaux d'Achat]
            D3 --> MERGE
        end
        
        subgraph EvolTech["Intelligence d'Évolution Technologique"]
            E1[Agent IA d'Adaptation aux Cycles d'Innovation]
            E1 --> E2[Agent IA d'Extension Domaines Technologiques]
            E2 --> E3[Agent IA de Renforcement Détection Disruptive]
            E3 --> MERGE
        end
        
        subgraph EvolJur["Intelligence d'Évolution Juridique"]
            F1[Agent IA d'Adaptation aux Mécanismes Normatifs]
            F1 --> F2[Agent IA d'Élargissement Périmètre Géographique]
            F2 --> F3[Agent IA de Renforcement Analyse d'Impact]
            F3 --> MERGE
        end
        
        MERGE{Intégration\ndes évolutions\nspécifiques}
        
        MERGE --> G1
        
        subgraph Gouvernance["Intelligence de Gouvernance Système"]
            G1[Agent IA de Pilotage Stratégique]
            G1 --> G2[Agent IA de Conformité Éthique]
            G2 --> G3[Agent IA de Gestion des Risques]
            G3 --> G4[Agent IA d'Adaptation Organisationnelle]
        end
        
        G4 --> OUTPUT[/Système évolutif avec gouvernance intégrée/]
        OUTPUT --> END([Système complet et auto-adaptatif])
    end
    
    %% Styles améliorés avec meilleur contraste
    classDef intelligence fill:#8a2be2,stroke:#000,stroke-width:2px,color:#fff
    classDef process fill:#4682b4,stroke:#000,stroke-width:1px,color:#fff
    classDef document fill:#f5a742,stroke:#000,stroke-width:1px,color:#000
    classDef decision fill:#d81b60,stroke:#000,stroke-width:1px,color:#fff
    classDef subgraphStyle fill:#f5f5f5,stroke:#333,stroke-width:1px
    
    %% Application des styles
    class A1,A2,A3,B1,B2,B3,C1,C2,C3,D1,D2,D3,E1,E2,E3,F1,F2,F3,G1,G2,G3,G4 intelligence
    class START,END process
    class INPUT,OUTPUT document
    class BRANCH,MERGE decision
    class EvolFonda,EvolConc,EvolStrat,EvolCom,EvolTech,EvolJur,Gouvernance subgraphStyle