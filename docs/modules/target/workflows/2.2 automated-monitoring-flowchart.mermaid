flowchart TD
    subgraph Surveillance["Surveillance Automatisée et Optimisée (Phase 2.2)"]
        START([Configuration des sources de la phase 2.1]) --> INPUT[/Sources et paramètres de collecte/]
        
        subgraph Crawling["Intelligence de Crawling Adaptatif"]
            INPUT --> A1[Agent IA de Crawling Intelligent]
            A1 --> A2[Agent IA Anti-Détection]
            A2 --> A3[Agent IA de Profondeur Adaptative]
            A3 --> BRANCH{Spécialisation\npar type\nde veille}
        end
        
        BRANCH -->|Veille Concurrentielle| B1
        BRANCH -->|Veille Stratégique| C1
        BRANCH -->|Veille Commerciale| D1
        BRANCH -->|Veille Technologique| E1
        BRANCH -->|Veille Juridique| F1
        
        subgraph SurvConc["Intelligence de Surveillance Concurrentielle"]
            B1[Agent IA de Monitoring Prix et Produits]
            B1 --> B2[Agent IA de Détection Marketing]
            B2 --> B3[Agent IA d'Analyse de Positionnement]
            B3 --> MERGE
        end
        
        subgraph SurvStrat["Intelligence de Surveillance Stratégique"]
            C1[Agent IA de Monitoring Indicateurs Macro]
            C1 --> C2[Agent IA de Détection de Tendances]
            C2 --> C3[Agent IA d'Analyse Disruptive]
            C3 --> MERGE
        end
        
        subgraph SurvCom["Intelligence de Surveillance Commerciale"]
            D1[Agent IA de Monitoring Triggers d'Achat]
            D1 --> D2[Agent IA de Détection d'Appels d'Offres]
            D2 --> D3[Agent IA d'Analyse d'Intention d'Achat]
            D3 --> MERGE
        end
        
        subgraph SurvTech["Intelligence de Surveillance Technologique"]
            E1[Agent IA de Monitoring Code et Commits]
            E1 --> E2[Agent IA de Détection de Publications]
            E2 --> E3[Agent IA d'Analyse de Standards]
            E3 --> MERGE
        end
        
        subgraph SurvJur["Intelligence de Surveillance Juridique"]
            F1[Agent IA de Monitoring Publications Officielles]
            F1 --> F2[Agent IA de Détection Jurisprudentielle]
            F2 --> F3[Agent IA d'Analyse Consultative]
            F3 --> MERGE
        end
        
        MERGE{Intégration\ndes flux\nde données}
        
        MERGE --> G1
        
        subgraph Optimisation["Intelligence d'Optimisation Continue"]
            G1[Agent IA de Déduplication]
            G1 --> G2[Agent IA d'Archivage Intelligent]
            G2 --> G3[Agent IA d'Apprentissage par Feedback]
            G3 --> G4[Agent IA de Découverte de Sources]
        end
        
        G4 --> OUTPUT[/Données brutes collectées et structurées/]
        OUTPUT --> END([Passage à la phase 3.1])
    end
    
    %% Styles améliorés avec meilleur contraste
    classDef intelligence fill:#8a2be2,stroke:#000,stroke-width:2px,color:#fff
    classDef process fill:#4682b4,stroke:#000,stroke-width:1px,color:#fff
    classDef document fill:#f5a742,stroke:#000,stroke-width:1px,color:#000
    classDef decision fill:#d81b60,stroke:#000,stroke-width:1px,color:#fff
    classDef subgraphStyle fill:#f5f5f5,stroke:#333,stroke-width:1px
    
    %% Application des styles
    class A1,A2,A3,B1,B2,B3,C1,C2,C3,D1,D2,D3,E1,E2,E3,F1,F2,F3,G1,G2,G3,G4 intelligence
    class START,END process
    class INPUT,OUTPUT document
    class BRANCH,MERGE decision
    class Crawling,SurvConc,SurvStrat,SurvCom,SurvTech,SurvJur,Optimisation subgraphStyle