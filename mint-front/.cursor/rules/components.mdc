// @ts-check

/**
 * Simplified Component Selection Rule for Cursor
 * 
 * This rule implements a hierarchical component selection strategy:
 * 1. First try to use components from @owlint/feathers-vue
 * 2. If not found and it's an atomic UI component, use reka-ui
 * 3. If still not found, prompt the user about creating a custom component
 * 
 * It relies on Cursor's ability to discover component names from documentation.
 */

const rule = {
  name: "component-selection-hierarchy",
  description: "Enforces the hierarchical selection of UI components from feathers-vue and reka-ui",
  severity: "warning",

  // Configuration options
  config: {
    // Libraries in order of preference
    libraryHierarchy: [
      {
        name: "feathers",
        packageName: "@owlint/feathers-vue",
        prefix: "O"
      },
      {
        name: "rekaUI",
        packageName: "reka-ui",
        prefix: "Reka"
      }
    ],
    
    // List of atomic UI components that should follow the hierarchical selection logic
    atomicUIComponents: [
      "button", "input", "select", "checkbox", "radio", "switch", "toggle", 
      "modal", "dialog", "dropdown", "menu", "tabs", "tab", "card", 
      "alert", "toast", "badge", "avatar", "spinner", "progress", "slider", "table"
    ]
  },

  // The apply function runs against each file matching the given pattern
  applies: (file) => {
    return file.endsWith('.vue') || file.endsWith('.ts') || file.endsWith('.js');
  },

  // The check function implements the rule logic
  check: (text, file) => {
    const violations = [];
    const atomicElements = rule.config.atomicUIComponents;
    
    // Check for standard HTML elements that are in our atomic list
    for (const element of atomicElements) {
      const regex = new RegExp(`<${element}[\\s>]`, 'g');
      let match;
      
      while ((match = regex.exec(text)) !== null) {
        // Determine which library to use
        const librarySelection = determineAppropriateLibrary(element, text.substring(match.index, match.index + 100));
        
        if (librarySelection.promptUser) {
          // No suitable component found, suggest asking the user
          violations.push({
            message: `No component found for <${element}> in any of the component libraries. Consider asking the user if a custom component should be created.`,
            line: text.substring(0, match.index).split('\n').length,
            position: match.index,
            promptUser: true,
            elementType: element
          });
        } else {
          // Component found in one of the libraries
          violations.push({
            message: librarySelection.message,
            line: text.substring(0, match.index).split('\n').length,
            position: match.index,
            fix: {
              elementType: element,
              library: librarySelection.library,
              componentHint: librarySelection.componentHint
            }
          });
        }
      }
    }
    
    return violations;
  },
  
  // The fix function applies the suggested fixes
  fix: (text, violations, file) => {
    let newText = text;
    
    // Process violations that need user prompting first
    const promptViolations = violations.filter(v => v.promptUser);
    if (promptViolations.length > 0) {
      // Insert comments for elements that need user input
      for (const violation of promptViolations) {
        const lineIndex = violation.line - 1;
        const lines = newText.split('\n');
        
        // Calculate position within the line
        const startOfLine = newText.split('\n').slice(0, lineIndex).join('\n').length + (lineIndex > 0 ? 1 : 0);
        const positionInLine = violation.position - startOfLine;
        
        const commentText = `<!-- TODO: No component found for <${violation.elementType}> in @owlint/feathers-vue or reka-ui. Ask the user if a custom component should be created. -->`;
        
        lines[lineIndex] = lines[lineIndex].substring(0, positionInLine) + 
                          commentText + '\n' + 
                          lines[lineIndex].substring(positionInLine);
        
        newText = lines.join('\n');
      }
    }
    
    // Let Cursor handle the component replacement and imports based on the hints
    // This simplified approach trusts Cursor to find the appropriate component name
    // and add the correct import statement based on the library and component hint
    
    return newText;
  }
};

/**
 * Helper function to determine which library should provide the component
 * @param {string} elementType - The HTML element type
 * @param {string} contextText - The surrounding text for additional context
 * @returns {Object} - Information about the selected library and component
 */
function determineAppropriateLibrary(elementType, contextText) {
  // Special case for select elements - should try RekaUI immediately if 
  // the element is a select and first library lacks a direct equivalent
  if (elementType === "select") {
    // Let Cursor discover if Feathers has a select component
    // If not, it should use RekaUI
    return {
      library: "rekaUI",
      message: `Use a component from reka-ui for select elements as @owlint/feathers-vue may not have a direct equivalent`,
      componentHint: `select`
    };
  }
  
  // Special case for input with type
  if (elementType === "input") {
    const typeMatch = contextText.match(/type=["'](mdc:\w+)["']/);
    if (typeMatch && typeMatch[1]) {
      const inputType = typeMatch[1];
      
      // Special case for input type="select" - should use RekaUI's select component
      if (inputType === "select") {
        return {
          library: "rekaUI", 
          message: `Use a component from reka-ui for select inputs`,
          componentHint: `select`
        };
      }
      
      // For other input types, provide the type as a hint but follow standard hierarchy
      return {
        library: "feathers",
        message: `Try to use a component from @owlint/feathers-vue for ${inputType} input, falling back to reka-ui if needed`,
        componentHint: inputType
      };
    }
  }
  
  // Standard hierarchy - try Feathers first, then RekaUI
  return {
    library: "feathers",
    message: `Try to use a component from @owlint/feathers-vue for ${elementType}, falling back to reka-ui if needed`,
    componentHint: elementType
  };
}

module.exports = rule;