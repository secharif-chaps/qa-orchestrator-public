{
  "name": "mint",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest --config vitest.config.unit.ts",
    "test:ui": "vitest --ui --config vitest.config.ui.ts",
    "test:e2e": "vitest --config vitest.config.e2e.ts",
    "test:unit": "vitest --config vitest.config.unit.ts",
    "test:coverage": "vitest --coverage",
    "test:watch": "vitest --watch --config vitest.config.unit.ts",
    "test:all": "yarn test:unit && yarn test:e2e",
    "dev:test": "concurrently \"yarn dev\" \"yarn test:watch\"",
    "validate": "yarn test:all"
  },
