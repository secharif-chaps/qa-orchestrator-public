# .env.example
# Copy to .env and adjust values as needed
# cp .env.example .env

# ─── Database ──────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=chapsmind_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ─── Keycloak (local) ───────────────────────────────
# The local dev stack runs its own Keycloak instance (port 8080).
# Realm and clients are auto-imported from infra/files/realm-chapsmind.json.
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=chapsmind
KEYCLOAK_CLIENT_ID=chapsmind-front
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_CLIENT_SECRET=changeme       # Ask a team member

# ─── RabbitMQ ─────────────────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ─── Dify (AI Platform) ──────────────────────────
DIFY_API_URL=https://dify.example.com/v1
DIFY_API_KEY=changeme                        # Ask a team member

# ─── Tunnel (Dify callbacks in local dev) ────────
# LocalTunnel subdomain for consistent URL across restarts
# Format: chapsmind-dev-<yourname> (e.g. chapsmind-dev-alex)
TUNNEL_SUBDOMAIN=chapsmind-dev-changeme

# ─── Backend ─────────────────────────────────────
BACKEND_SECRET_KEY=dev-secret-key-change-in-prod
BACKEND_CORS_ORIGINS=http://localhost:3000

# ─── Security ────────────────────────────────────
# Internal JWT for service-to-service communication (backend ↔ global-service)
INTERNAL_JWT_SECRET=local-dev-internal-jwt-secret-32chars

# Encryption key for sensitive data at rest
ENCRYPTION_KEY=changeme                      # Generate with: python -c "import secrets; print(secrets.token_hex(32))"

# Translation API
SYSTRAN_API_KEY=                             # Optional — leave empty if not using translation

# ─── Frontend ────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=chapsmind
VITE_KEYCLOAK_CLIENT_ID=chapsmind-front

# ─── Private Registry (Vuellar) ─────────────────
# Required for Docker builds. Get from Passbolt under "CHAPSMIND_VUELLAR"
OWLINT_REGISTRY_URL=changeme                    # Private npm registry URL
OWLINT_DEPLOY_KEY=changeme                      # Authentication token

# ─── Network (devcontainer) ────────────────────
# IP for git.mediaspeech.com and registry.git.mediaspeech.com (added to /etc/hosts in devcontainer)
GIT_MEDIASPEECH_IP=10.0.90.130