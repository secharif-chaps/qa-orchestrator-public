# ─── Docker Compose ───────────────────────────────────
COMPOSE_FILE=infra/compose.yaml:infra/compose.local.yaml
COMPOSE_PROJECT_NAME=chapsmind

# ─── Docker Images (staging/preprod only — in dev, compose.local.yaml overrides) ──
# DOCKER_REGISTRY=registry.git.mediaspeech.com/chapsmind/chapsmind
# DOCKER_CHAPSMIND_VERSION=latest

# ─── Database ─────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=chapsmind_db
GLOBAL_DB=global_db

# ─── RabbitMQ ─────────────────────────────────────────
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ─── Keycloak (staging/preprod — en local, overridé par compose.local.yaml) ──
KEYCLOAK_SERVER_URL=https://sso.example.com
KEYCLOAK_REALM=chapsmind
KEYCLOAK_CLIENT_ID=chapsmind-screen-back
KEYCLOAK_CLIENT_SECRET=changeme
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_CLIENT_SECRET=changeme

# ─── Security ─────────────────────────────────────────
# Internal JWT — must be identical on screen and global-service
# Generate: openssl rand -base64 32
INTERNAL_JWT_SECRET=changeme

# Encryption key for sensitive data at rest
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=changeme

# ─── External APIs ───────────────────────────────────
SYSTRAN_API_KEY=

# ─── Frontend (Vuellar private registry — get from Passbolt "CHAPSMIND_VUELLAR") ──
OWLINT_REGISTRY_URL=changeme
OWLINT_DEPLOY_KEY=changeme

# ─── Tunnel (local dev only — Dify callbacks) ─────────
# Format: chapsmind-dev-<yourname>
TUNNEL_SUBDOMAIN=chapsmind-dev-changeme