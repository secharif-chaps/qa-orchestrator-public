# ─── Docker Compose ───────────────────────────────────
COMPOSE_FILE=infra/compose.yaml:infra/compose.local.yaml
COMPOSE_PROJECT_NAME=chapsmind
COMPOSE_PROFILES=

# ─── Docker Images (staging/preprod only — in dev, compose.local.yaml overrides) ──
# DOCKER_REGISTRY=registry.git.mediaspeech.com/chapsmind/chapsmind
# DOCKER_CHAPSMIND_VERSION=latest

# ─── Database ─────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=chapsmind_db
GLOBAL_DB=global_db

# ─── Keycloak (staging/preprod only — in dev, compose.local.yaml overrides) ──
# KEYCLOAK_SERVER_URL=https://sso.example.com
# KEYCLOAK_REALM=chapsmind
# KEYCLOAK_CLIENT_ID=chapsmind-gloabl-service
# KEYCLOAK_CLIENT_SECRET=
# KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
# KEYCLOAK_ADMIN_CLIENT_SECRET=

# ─── LLM (OpenAI-compatible endpoint) ──────────────
LLM_PROVIDER=openai
LLM_API_KEY=changeme
LLM_BASE_URL=changeme
LLM_MODEL=gpt-5.1-sweden
LLM_API_VERSION=

# ─── Evals (promptfoo) ───────────────────────────────
# Optional: eval-specific LLM credentials (override the app LLM vars above).
# If unset, evals fall back to LLM_API_KEY / LLM_BASE_URL.
# PROMPTFOO_LLM_API_KEY=changeme
# PROMPTFOO_LLM_BASE_URL=changeme

# ─── Security ─────────────────────────────────────────
# Internal JWT — must be identical on screen and global-service
# Generate: openssl rand -base64 32
INTERNAL_JWT_SECRET=changeme

# Mercure JWT — used by Target's embedded FrankenPHP/Mercure hub
# Generate: openssl rand -base64 32
MERCURE_JWT_SECRET=changeme

# Encryption key for sensitive data at rest (Fernet — 32 url-safe base64-encoded bytes)
# Generate: docker compose run --rm --no-deps -T --entrypoint python3 global-service -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#           or: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=changeme

# ─── Dev ─────────────────────────────────────────────
# Enable uvicorn hot-reload in local dev (default: true via compose.local.yaml)
# Set to false to test production-like startup locally
# DEV_MODE=false

# ─── External APIs ───────────────────────────────────
SYSTRAN_API_KEY=

# Cloudflare Browser Rendering — used by HtmlFetcher to fetch fully-rendered HTML
# (manual document creation, JS-heavy sites). Without these, document:create
# and the manual API endpoint will fail with a clear "not configured" error.
# Credentials available in Passbolt (search 'Cloudflare Browser Rendering - dev').
CLOUDFLARE_ACCOUNT_ID=changeme
CLOUDFLARE_BR_API_TOKEN=changeme
