# QA Orchestrator — Environment Variables
# Copy to .env and fill in your keys

# Anthropic API (required)
QA_HUB_ANTHROPIC_KEY=sk-ant-api03-xxxxx

# GitLab (required for MR analysis)
QA_HUB_GITLAB_HOST=git.mediaspeech.com
QA_HUB_GITLAB_PORT=17890
QA_HUB_GITLAB_TOKEN=glpat-xxxxx

# Atlassian (used by agents via MCP — the cloud ID is in project config)
# No token needed here — MCP handles auth through Claude

# Scanner endpoint (optional — for remote scanning)
# QA_HUB_SCAN_ENDPOINT=http://localhost:3001/api/qa-hub/scan
